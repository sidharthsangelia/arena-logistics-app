generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum OrgPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum KycDocType {
  PAN_CARD // individual / founder / proprietor PAN
  COMPANY_PAN // company's PAN (commercial shipments) — distinct from the founder's PAN_CARD
  ADHAR_CARD
  GST_CERTIFICATE
  IEC_CODE
  MSME_CERTIFICATE
  INCORPORATION_CERT
  CANCELLED_CHEQUE
  BANK_STATEMENT
  TRADE_LICENSE
  AUTHORIZED_SIGNATORY
  LUT // Letter of Undertaking — zero-rated/no-IGST exports
  OTHER
}

// NOTE: Vendor is intentionally NOT an enum.
// Your adapter registry already uses string IDs ("aramex", "skart", "fedex").
// A DB enum means a migration every time you add a carrier — avoid it.

// ─────────────────────────────────────────────
// Org (tenant root)
// ─────────────────────────────────────────────

model Org {
  id         String  @id @default(cuid())
  clerkOrgId String  @unique
  slug       String  @unique
  name       String
  logoUrl    String?
  plan       OrgPlan @default(FREE)

  // Razorpay billing stubs — optional, populate when payment is wired up
  razorpayCustomerId     String? @unique
  razorpaySubscriptionId String? @unique

  // Relations
  vendorKeys VendorKey[]
  clients    Client[]
  quotes     Quote[]
  documents  ClientDocument[]

  markupPercent       Decimal @default(30.000) @db.Decimal(6, 3)
  isBusinessAssociate Boolean @default(false) // flips markup down (e.g. to 15%) when true — set by you/ops, not self-serve; gates the /clients route

  wallet         Wallet?
  kycDocuments   KycDocument[]
  kycWaivers     KycWaiver[]
  addresses      Address[]
  shipments      Shipment[]
  baApplications BaApplication[]
  bookingDrafts  BookingDraft[]

  billingParties BillingParty[]
  manualInvoices ManualInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyName  String?
  contactName  String?
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  notes        String?

  skipPayment        Boolean           @default(false)
  profileCompletedAt DateTime?
  emailEvents        QuoteEmailEvent[]

  // ── client-facing shipment emails (business associates only) ──
  //
  // A BA books on behalf of its own clients, and milestone emails already reached
  // those clients before this existed. That was never something the BA agreed to,
  // so it is now opt-in: with clientEmailsEnabled false, milestone mail goes to
  // the BA's own address instead of the client's. Nobody goes dark either way.
  //
  // clientEmailMilestones is the subset of statuses the client hears about. Only
  // the five EMAIL_MILESTONE_STATUSES are ever stored here; the rest of the enum
  // has no customer-facing email at all. An empty list with the toggle on would
  // send nothing, which the settings form refuses to save.
  //
  // Ignored entirely for standard orgs, who ship for themselves and have no
  // clients to shield.
  clientEmailsEnabled   Boolean          @default(false)
  clientEmailMilestones ShipmentStatus[] @default([BOOKED, PROCESSING, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED])
  /// Where a client's reply lands. Falls back to Org.email when unset.
  clientEmailReplyTo    String?

  notifications Notification[]

  invoices Invoice[]

  // ── GST identity (goes on every tax invoice Arena raises to this org) ──
  //
  // Nullable because plenty of customers are individuals with no registration
  // at all, and an invoice to them is perfectly valid printed "Unregistered".
  // What is NOT acceptable is guessing: an invoice carrying the wrong GSTIN is
  // useless to the customer's accountant and a correction we have to issue a
  // credit note for.
  //
  // gstStateCode is the 2-digit GST state code that decides place of supply,
  // and therefore whether the invoice carries IGST or a CGST/SGST split. It is
  // stored separately from `state` above because that field is free text and
  // always has been, so it cannot be relied on to resolve to a code. When a
  // GSTIN is present its first two digits ARE the state code and win, since
  // they are the registered value rather than something typed into a form.
  gstin        String?
  gstStateCode String?

  // ── export profile (international bookings) ──
  // Who this party legally is at customs, and under what papers. Every
  // international vendor demands some subset of these, so they are structured
  // columns rather than free text dug out of KycDocument.docNumber: a booking
  // preflight has to be able to say "your AD code is missing" before the
  // customer's money has bought a booking the vendor will refuse.
  //
  // The SAME block exists on Client. For a BA org booking on behalf of a
  // client, the CLIENT is the legal exporter, so the client's values win and
  // these are the fallback. Resolution lives in lib/booking/exportProfile.ts —
  // never read these columns directly.
  iecNumber         String? // Importer Exporter Code, mandatory for commercial exports
  adCode            String? // Authorised Dealer code, ties the shipment to a bank
  lutNumber         String? // Letter of Undertaking, for zero-rated exports
  lutIssueDate      DateTime?
  lutTillDate       DateTime? // LUTs expire; a stale one is refused at the border
  iossNumber        String? // EU IOSS registration, for low-value consignments
  defaultIncoterms  Incoterms  @default(DDP)
  // NA, not LUT. An org that has not told us how it exports is claiming nothing,
  // and defaulting to LUT meant every org was treated as claiming zero-rated
  // relief under a Letter of Undertaking it did not hold — which then blocked
  // its bookings on a missing LUT number it was never asked for. Shipmozo's own
  // default for the same field is NA. Orgs that do ship under an LUT set it, and
  // give us the number, on the export profile form in settings.
  defaultExportType ExportType @default(NA)

  shipmentInvoices ShipmentInvoice[]

  @@index([slug])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// VendorKey (BYOK — one row per carrier per org)
// ─────────────────────────────────────────────

model VendorKey {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  vendorId String // "aramex" | "skart" | "fedex" — matches adapter registry
  label    String // display name e.g. "Aramex Production"
  notes    String?

  encryptedPayload String
  iv               String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, vendorId])
  @@index([orgId])
}

// ─────────────────────────────────────────────
// Client
// ─────────────────────────────────────────────

model Client {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  companyName  String
  contactName  String?
  email        String?
  phone        String?
  addressLine1 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  notes        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyKind CompanyKind @default(INDIVIDUAL)

  // ── export profile (international bookings) ──
  // Same block as Org, and it WINS over the org's when set: for a BA org
  // booking on behalf of a client, the client is the party actually exporting,
  // so their IEC and AD code are the ones that belong on the paperwork. See the
  // long note on Org, and resolve through lib/booking/exportProfile.ts.
  //
  // Nullable enums here, unlike Org's defaulted ones, precisely so "this client
  // has not told us" stays distinguishable from "this client chose DDP".
  gstin             String?
  iecNumber         String?
  adCode            String?
  lutNumber         String?
  lutIssueDate      DateTime?
  lutTillDate       DateTime?
  iossNumber        String?
  defaultIncoterms  Incoterms?
  defaultExportType ExportType?

  // Per-client override of the BA's org-wide clientEmailsEnabled setting.
  // Deliberately three-state rather than a boolean: INHERIT means "whatever the
  // org setting says", so flipping the org toggle still moves every client the BA
  // never made an explicit decision about. A boolean would have had to be
  // backfilled to a concrete value, freezing today's default in place forever.
  emailPreference ClientEmailPreference @default(INHERIT)

  kycDocuments KycDocument[]
  kycWaivers   KycWaiver[]
  addresses    Address[]
  shipments    Shipment[]

  quotes    Quote[]
  documents ClientDocument[]

  billingParties BillingParty[]
  rateQuotations RateQuotation[]

  @@index([orgId])
  @@index([orgId, companyName])
  @@index([email])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────
// Quote
// ─────────────────────────────────────────────

model Quote {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quoteNumber String

  // Carrier / product
  vendorId    String
  vendorName  String
  productName String

  // Pricing
  currency      String
  subtotal      Decimal @db.Decimal(14, 4)
  tax           Decimal @db.Decimal(14, 4)
  total         Decimal @db.Decimal(14, 4)
  markupPercent Decimal @db.Decimal(6, 3)
  quotedTotal   Decimal @db.Decimal(14, 4)

  // Transit
  tatDays Int?

  // Immutable snapshots
  chargesSnapshot Json
  requestSnapshot Json

  // Generated PDF
  pdfUrl String?
  pdfKey String?

  // Validity
  validUntil DateTime

  // Workflow
  status QuoteStatus @default(DRAFT)

  // Client (optional — may be assigned after creation)
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  emailEvents       QuoteEmailEvent[]
  // Store the last Resend email ID so we can correlate webhook events
  lastResendEmailId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, quoteNumber])
  @@index([orgId])
  @@index([orgId, status])
  @@index([clientId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ClientDocument (KYC / document vault)
// ─────────────────────────────────────────────

model ClientDocument {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  docType     KycDocType
  label       String
  description String?

  fileUrl  String
  fileKey  String
  fileName String
  fileSize Int
  mimeType String

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
  @@index([clientId])
  @@index([orgId, docType])
  @@index([clientId, docType])
  // The Arena vault lists documents across every org ordered by uploadedAt, so
  // the default page has no org predicate to narrow on. Without this the sort is
  // a full scan. Mirrors Quote's @@index([createdAt]).
  @@index([uploadedAt])
}

model QuoteEmailEvent {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Resend's email ID — links all events for the same send
  resendEmailId String

  event      EmailEvent
  // Resend sends recipient's IP/userAgent on open/click — useful for ops
  userAgent  String?
  ipAddress  String?
  // For click events
  clickedUrl String?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([orgId])
  @@index([resendEmailId])
}

enum EmailEvent {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

// Domestic Air Shipment excel parsed rate data

enum RateVendor {
  EDS
  INDIGO
  AIR_INDIA
}

enum CargoType {
  GCR
  LEAN
  SCR
  HEA
  XPS
  DGR
  PRIME
}

model Airport {
  iataCode String @id @db.Char(3)

  city     String?
  state    String?
  isActive Boolean @default(true)

  originRateCards      RateCard[] @relation("OriginAirport")
  destinationRateCards RateCard[] @relation("DestinationAirport")

  createdAt DateTime @default(now())

  @@map("airports")
}

model RateVersion {
  id String @id @default(cuid())

  vendor RateVendor

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(false)
  isStaged Boolean @default(true)

  sourceFilename String

  uploadedBy String?

  uploadedAt DateTime @default(now())

  activatedAt DateTime?
  activatedBy String?

  notes String?

  rateCards  RateCard[]
  awbCharges VendorAwbCharge[]

  @@index([vendor, isActive])
}

model RateCard {
  id String @id @default(cuid())

  versionId String
  version   RateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  vendor RateVendor

  origin      String
  destination String

  originAirport      Airport @relation("OriginAirport", fields: [origin], references: [iataCode])
  destinationAirport Airport @relation("DestinationAirport", fields: [destination], references: [iataCode])

  cargoType CargoType

  commodity String?

  volDivisor Int @default(6000)

  rateIncludesSurcharges Boolean @default(false)

  region String?

  flightNo String?
  airline  String?
  depTime  String?
  arrTime  String?
  timeSlab String?

  consolCode String?

  isTransit         Boolean @default(false)
  opsSuspended      Boolean @default(false)
  componentMismatch Boolean @default(false)

  sector String?

  applicableFlightScope String?

  effectiveDate DateTime?

  remarks String?

  slabs      RateSlab[]
  surcharges FlightSurcharge[]

  createdAt DateTime @default(now())

  @@index([origin, destination])
  @@index([vendor, origin, destination, cargoType])
}

model RateSlab {
  id String @id @default(cuid())

  rateCardId String

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  slabLabel String

  weightMin Decimal @db.Decimal(10, 2)

  weightMax Decimal? @db.Decimal(10, 2)

  ratePerKg Decimal @db.Decimal(12, 4)

  minCharge Decimal? @db.Decimal(12, 2)

  rate100kg Decimal? @db.Decimal(12, 4)

  flatRate Decimal? @db.Decimal(12, 4)

  miscCharges Decimal? @db.Decimal(12, 4)

  airportOut Decimal? @db.Decimal(12, 4)

  airportRet Decimal? @db.Decimal(12, 4)

  surchargeComp Decimal? @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  @@index([rateCardId])
}

model FlightSurcharge {
  id String @id @default(cuid())

  rateCardId String

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  surchargeType String

  flightNo String?

  surchargePerKg Decimal @db.Decimal(12, 4)

  surchargeText String?

  appliesToCommodity String?

  createdAt DateTime @default(now())

  @@index([rateCardId])
}

model VendorAwbCharge {
  id String @id @default(cuid())

  versionId String

  version RateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  vendor RateVendor

  chargeType String

  amountPerKg Decimal? @db.Decimal(12, 4)

  amountFlat Decimal? @db.Decimal(12, 4)

  minAmount Decimal? @db.Decimal(12, 4)

  appliesTo String?

  notes String?

  createdAt DateTime @default(now())

  @@index([versionId])
}

model QuoteLog {
  id String @id @default(cuid())

  origin      String
  destination String

  cargoType String

  actualWeightKg Decimal @db.Decimal(12, 2)

  chargeableWeight Decimal @db.Decimal(12, 2)

  selectedVendor String?

  totalQuote Decimal? @db.Decimal(12, 2)

  bookingId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum PartyType {
  ORG // KYC/Address owner is the Org itself (shipping for itself)
  CLIENT // KYC/Address owner is a Client (Org booking on their behalf)
}

enum CompanyKind {
  INDIVIDUAL
  COMPANY
}

enum AddressKind {
  PICKUP
  DELIVERY
  BILLING
  OTHER // warehouse, registered office, etc. — free "any other" address-book type
}

// CSB-IV / CSB-V / Commercial — Indian customs export categories.
// Drives which KYC docs are required and how customs paperwork is handled.
// CSB4 is only valid while total declared value < ₹25,000; at/above that
// threshold a shipment must be CSB5 or COMMERCIAL (enforced in the app layer).
//
// INTERNATIONAL shipments only. A DOMESTIC shipment never crosses a customs
// border, so its shipmentType stays null — see ShipmentMode below.
enum ShipmentType {
  CSB4
  CSB5
  COMMERCIAL
}

// Which of the two booking flows produced this shipment.
//
// Deliberately a COLUMN on Shipment rather than a second table. Shipment is the
// hub for PackageItem, ShipmentDocument, ShipmentStatusEvent, WalletTransaction,
// Invoice and PaymentCollection; splitting it would turn every one of those
// foreign keys either into a duplicate or into a nullable polymorphic pair with
// no referential integrity, and every list/count/search query into a UNION.
// Ops separation is a VIEW concern and is solved by filtering on this column
// (the arena dashboard gives domestic its own route), not by splitting storage.
//
// The schema already carries mode-specific nullable blocks for exactly this
// reason: mawbNumber/hawbNumber are air-export only and the whole firstMile*
// block is door-pickup only. The domestic* block below follows that pattern.
enum ShipmentMode {
  INTERNATIONAL // India → abroad, customs category + KYC matrix apply
  DOMESTIC // India → India, GST paperwork applies instead
}

enum ShipmentStatus {
  DRAFT // form in progress, not yet submitted
  PENDING_PAYMENT // service selected, awaiting wallet debit
  BOOKED // payment captured, sitting in ops queue
  PROCESSING // ops has picked it up
  DOCUMENTS_PENDING // ops needs more docs (AWB etc.) before moving
  IN_TRANSIT
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  ON_HOLD
}

// The door → carrier-hub leg, when a customer opts into door pickup. Linear:
// ops advances it one stage at a time. The main ShipmentStatus lifecycle covers
// everything from the hub onward, so this stops at ARRIVED_AT_HUB.
enum FirstMileStatus {
  SCHEDULED // pickup booked with the domestic courier, not yet collected
  PICKED_UP // courier has collected the parcel from the sender's door
  IN_TRANSIT_TO_HUB // on the way to the carrier hub
  ARRIVED_AT_HUB // reached the hub; the international leg takes over from here
}

enum ShipmentDocType {
  INVOICE // mandatory, fresh per shipment — commercial invoice (export) or GST tax invoice (domestic)
  AIRWAY_BILL
  PACKING_LIST
  CUSTOMS_DECLARATION
  CERTIFICATE_OF_ORIGIN
  INSURANCE_CERT
  POD // proof of delivery
  // ── domestic (GST) paperwork ──
  E_WAY_BILL // required once declared value exceeds ₹50,000
  DELIVERY_CHALLAN // goods moving without a sale (stock transfer, branch movement, repair)
  OTHER
}

enum WalletTxnType {
  TOP_UP
  SHIPMENT_DEBIT
  REFUND
  ADJUSTMENT // legacy, direction ambiguous — use MANUAL_CREDIT / MANUAL_DEBIT instead
  MANUAL_CREDIT // ops added money by hand, e.g. a NEFT or cheque received offline
  MANUAL_DEBIT // ops took money out by hand, e.g. correcting an over-credit
}

enum WalletTxnStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum BaApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// KycDocument — polymorphic: belongs to an Org
// (shipping for itself) OR a Client (Org booking
// on their behalf). Exactly one FK is set.
// Same spirit as your existing ClientDocument —
// this is the generalized successor; once this
// is in place you can fold ClientDocument's data
// into it, or keep both running side by side.
// ─────────────────────────────────────────────

model KycDocument {
  id String @id @default(cuid())

  partyType PartyType
  orgId     String?
  org       Org?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  docType     KycDocType
  label       String
  docNumber   String? // e.g. PAN number, GSTIN — queryable without opening the file
  description String?

  fileUrl  String
  fileKey  String
  fileName String
  fileSize Int
  mimeType String

  verifiedAt DateTime? // ops marks this once checked
  verifiedBy String?
  expiresAt  DateTime? // optional — IEC/trade license renewals etc.

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // exactly one of orgId / clientId should be non-null — enforce in app layer
  // (add a DB CHECK constraint via raw SQL migration if you want belt-and-braces)

  @@index([orgId])
  @@index([clientId])
  @@index([orgId, docType])
  @@index([clientId, docType])
}

// ─────────────────────────────────────────────
// KycWaiver — "we spoke to ops, book it anyway"
//
// A customer who has not finished their paperwork can still be let through
// after a conversation with the operations team. An Arena ADMIN records that
// conversation here, and while the waiver is live the booking wizard asks the
// party for their Aadhaar only: PAN, Company PAN, GST, IEC and LUT all stop
// being mandatory. Aadhaar is never waivable — it is the one identity document
// the shipment cannot move without.
//
// WHY A TABLE AND NOT A BOOLEAN ON Org/Client
// A boolean records that KYC is off. It does not record who turned it off, why,
// or when it should stop. Those three are the whole point: a waiver is a
// commercial exception to a compliance rule, so it has to answer to somebody
// later. Every grant and every revoke stays on the row, so the history reads
// years afterwards, including for parties whose waiver has long expired.
//
// Polymorphic, exactly like KycDocument: exactly one of orgId / clientId is set.
// An org's waiver covers only the org's own shipments; a BA's client needs their
// own waiver. That is deliberate — one conversation about one shipper should
// never quietly excuse a BA's entire book of clients.
//
// ACTIVE means: revokedAt is null AND expiresAt is in the future. Expiry is
// mandatory, so a waiver nobody remembers to revoke closes itself.
// ─────────────────────────────────────────────

model KycWaiver {
  id String @id @default(cuid())

  partyType PartyType
  orgId     String?
  org       Org?      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Why ops allowed this. Required — a waiver with no stated reason is not one.
  reason    String
  /// Hard stop. The full document matrix applies again from this moment on.
  expiresAt DateTime

  grantedBy     String // Clerk user id of the Arena admin
  grantedByName String? // display name snapshot, so it survives them leaving
  grantedAt     DateTime @default(now())

  revokedAt     DateTime?
  revokedBy     String?
  revokedByName String?

  // The hot read is "is there a live waiver for this party", run on every KYC
  // step render and again on every booking submit. Both indexes cover it.
  @@index([orgId, revokedAt, expiresAt])
  @@index([clientId, revokedAt, expiresAt])
}

// ─────────────────────────────────────────────
// Address — polymorphic, same pattern as KycDocument.
// Reusable address-book entries for pickup/delivery/billing.
// ─────────────────────────────────────────────

model Address {
  id String @id @default(cuid())

  orgId    String?
  org      Org?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label String? // "Warehouse 2", "Registered office" — optional nickname for reuse
  kind  AddressKind? // default/suggested use (pickup/delivery/billing) for address-book filtering — not enforced; any saved address can still be picked for any role on a shipment

  contactName  String?
  contactPhone String?
  contactEmail String? // optional — address-book entries can carry an email for notifications/invoice
  // The party's trading name, when they gave one. Collected by the booking form
  // on every address block but previously discarded here, which lost it for
  // good the moment a shipment was created.
  //
  // It is not decoration. On a DOMESTIC booking, whether a party filled this in
  // is exactly what decides their GST paperwork (a company sender owes a tax
  // invoice, an individual does not) — see lib/booking/domesticDocs.ts. Without
  // it persisted, ops cannot tell after the fact which rule a shipment was
  // judged against. Nullable because an individual legitimately has none.
  companyName  String?

  line1      String
  line2      String?
  city       String
  state      String?
  country    String
  postalCode String

  // for serviceability lookups against your rate cards / pincode coverage
  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  pickupShipments   Shipment[] @relation("PickupAddress")
  deliveryShipments Shipment[] @relation("DeliveryAddress")
  billingShipments  Shipment[] @relation("BillingAddress")

  @@index([orgId])
  @@index([clientId])
  @@index([postalCode])
  @@index([orgId, kind])
  @@index([clientId, kind])
}

// ─────────────────────────────────────────────
// Wallet + ledger — Org only.
// Org's wallet pays for its own shipments AND
// any shipment it books on behalf of a Client
// (confirmed: BA fronts the cost, Client has no
// separate wallet of its own).
// Balance cached on Wallet for fast reads;
// WalletTransaction is the append-only source of
// truth. Razorpay fields are nullable stubs for now.
// ─────────────────────────────────────────────

model Wallet {
  id    String @id @default(cuid())
  orgId String @unique
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  balance  Decimal @default(0) @db.Decimal(14, 4)
  currency String  @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type   WalletTxnType
  status WalletTxnStatus @default(PENDING)

  amount   Decimal @db.Decimal(14, 4) // always positive; type determines direction
  currency String  @default("INR")

  balanceAfter Decimal? @db.Decimal(14, 4) // running balance after this txn, set at write time

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  // Razorpay stubs — populate once payments are wired up
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  notes String?

  // Who moved this money, when a human did. Null for anything the system wrote
  // (shipment debits, webhook credits). The display name is snapshotted so the
  // ledger renders without a Clerk lookup per row, and still reads correctly if
  // the person later leaves the team.
  createdByUserId String?
  createdByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([razorpayOrderId])
  @@index([walletId])
  @@index([shipmentId])
  @@index([razorpayPaymentId])
  @@index([walletId, createdAt])
}

// ─────────────────────────────────────────────
// Shipment — the actual booking.
// orgId = who's booking/paying (always set).
// clientId = who it's FOR, if not the Org itself
//   (null = Org shipping for itself,
//    set  = Org booking on behalf of that Client).
// ─────────────────────────────────────────────

model Shipment {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  shipmentNumber String @unique // human-facing tracking-style ID, e.g. "ARN260130748291". Rows created before the format change keep the old "SHP-2026-00123" shape — both coexist, nothing is backfilled.

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // ── customer-facing contact snapshot ──
  // Who receives the shipment status emails (booking confirmation + each
  // milestone). Resolved and frozen at booking time: for a BA org booking on
  // behalf of a client this is the CLIENT (the real sender); otherwise it's the
  // consignor entered in the wizard. Snapshotted here because the consignor's
  // email is not otherwise reliably persisted (the pickup address may be a
  // different location), and so later status emails need no re-derivation.
  senderEmail String? // recipient for status emails; null = no email on file
  senderName  String? // greeting name, e.g. "Hi Adnan,"

  // ── addresses ──
  pickupAddressId String
  pickupAddress   Address @relation("PickupAddress", fields: [pickupAddressId], references: [id])

  deliveryAddressId String
  deliveryAddress   Address @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])

  billingAddressId      String?
  billingAddress        Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingSameAsDelivery Boolean  @default(true)

  // ── package / cargo details ──
  packages PackageItem[]

  // Which booking flow produced this shipment. Defaults to INTERNATIONAL so
  // every row that existed before domestic booking was built keeps its meaning
  // without a backfill.
  mode ShipmentMode @default(INTERNATIONAL)

  // CSB4 / CSB5 / COMMERCIAL — set once packages are entered. Nullable so a
  // half-finished DRAFT (or legacy row) can exist without it. Always null on a
  // DOMESTIC shipment: there is no customs category on an India → India move.
  shipmentType ShipmentType?

  // True when this booking passed the KYC gate under a live KycWaiver rather
  // than a complete document set. Frozen here at booking time because the
  // waiver itself expires: without the snapshot, a shipment that ops let
  // through on an exception becomes indistinguishable a month later from one
  // that was fully papered. Ops sees it on the booking detail page.
  kycWaivedAtBooking Boolean @default(false)

  declaredCargoType       String? // free text, or map to your existing CargoType enum if useful here too
  totalActualWeightKg     Decimal? @db.Decimal(12, 2)
  totalChargeableWeightKg Decimal? @db.Decimal(12, 2)

  // ── first-mile (door → carrier hub) pickup ──
  // Only relevant when the customer opts into door pickup. The chosen
  // domestic courier (via Shipmozo) that carries the parcel from the sender's
  // door to the selected international vendor's nearest hub, priced with the
  // org's markup already applied. Snapshotted at booking time like the main
  // service, so later rate/markup changes don't rewrite history.
  pickupIncluded          Boolean  @default(false)
  firstMileVendorId       String?
  firstMileVendorName     String?
  firstMileCharge         Decimal? @db.Decimal(14, 4)
  firstMileHubLabel       String? // which hub the parcel is routed to (e.g. "Dwarka, New Delhi")
  firstMileChargeSnapshot Json? // full first-mile price breakdown shown at selection time

  // ── first-mile leg tracking (door → hub) ──
  // Only meaningful when pickupIncluded. The door→hub courier moves on its own
  // schedule ahead of the international leg, so it gets a small, separate
  // lifecycle that ops advances by hand (there is no domestic-courier tracking
  // adapter yet). The main ShipmentStatus only takes over once the parcel has
  // reached the hub. Set to SCHEDULED at booking time; null on shipments with no
  // door pickup. arrivedAtHub is the trigger point for pay-on-arrival collection.
  firstMileStatus            FirstMileStatus? // null = no door pickup on this shipment
  firstMileTrackingNumber    String? // domestic courier AWB, once ops has it
  firstMileTrackingUrl       String? // courier's public tracking page, if any
  firstMilePickupScheduledAt DateTime? // when the courier is booked to collect
  firstMilePickedUpAt        DateTime? // stamped when marked PICKED_UP
  firstMileHubArrivedAt      DateTime? // stamped when marked ARRIVED_AT_HUB
  firstMileStatusUpdatedAt   DateTime? // last first-mile status change

  // Shipmozo domestic order booked from the ops dashboard (push-order → assign
  // courier → schedule pickup). The order id is Shipmozo's handle for label /
  // cancel / detail lookups; the AWB it returns is stored in
  // firstMileTrackingNumber above and drives the tracking webhook match.
  firstMileShipmozoOrderId     String? // Shipmozo order_id, once ops books the pickup
  firstMileBookedAt            DateTime? // when ops pushed the order to Shipmozo
  // In Shipmozo a "warehouse" is the pickup point, so we register one per
  // booking from the customer's pickup address (forward order: warehouse =
  // pickup, consignee = our hub). Stored so a retry reuses it, never duplicates.
  firstMileShipmozoWarehouseId String?

  // Payment collected on arrival at the hub instead of up-front — set for
  // orgs with payments turned off (Org.skipPayment). The shipment still
  // becomes BOOKED and enters the ops queue, but flagged so ops can filter
  // "payment pending" bookings and follow up.
  paymentDeferred Boolean @default(false)

  // ── deferred payment collection ──
  // Only meaningful when paymentDeferred is true. Both fields are DERIVED from
  // the paymentCollections rows below and maintained in the same transaction as
  // every collection write, so the collections queue can filter and sort in SQL
  // without aggregating a join on every request. paymentCollections stays the
  // source of truth; if these two ever disagree with it, trust the rows.
  paymentCollectionStatus PaymentCollectionStatus @default(NOT_REQUIRED)
  paymentCollectedAmount  Decimal                 @default(0) @db.Decimal(14, 4)
  paymentCollections      PaymentCollection[]

  // ── selected service / rate snapshot ──
  // mirrors Quote's snapshot philosophy: price/service locked at booking time.
  // markupPercentApplied records what was actually used for THIS shipment,
  // even though it's normally just copied from Org.markupPercent at booking time —
  // keeps the historical record correct if you ever change an Org's markup later.
  selectedVendorId       String?
  selectedVendorName     String?
  selectedProductName    String?
  // The VENDOR's own id for the service the customer picked, snapshotted at
  // selection. A dedicated column rather than a dig through chargesSnapshot,
  // because this single value is what guarantees the parcel ships on the
  // service that was actually paid for: at booking time the vendor is handed
  // this id, not a product name matched by string. Null for vendors that expose
  // no id, in which case the booking adapter has to resolve one or refuse.
  selectedCourierId      String?
  markupPercentApplied   Decimal? @db.Decimal(6, 3)
  quotedTotal            Decimal? @db.Decimal(14, 4)
  currency               String   @default("INR")
  chargesSnapshot        Json? // full breakdown shown to customer at selection time
  serviceabilitySnapshot Json? // raw list of options shown, for audit/debugging

  // ── carrier / AWB tracking (air freight) ──
  // all optional — populated by ops once the vendor confirms booking
  mawbNumber        String? // Master Air Waybill — issued by the airline, covers the whole consolidated cargo
  hawbNumber        String? // House Air Waybill — issued to this specific shipper; usually what the client should track by
  carrierAirline    String? // e.g. "Emirates SkyCargo" — distinct from selectedVendorName (your logistics vendor/agent)
  vendorTrackingUrl String? // deep link to the carrier's public tracking page, if one exists
  awbAddedAt        DateTime? // when ops first recorded AWB info
  awbUpdatedAt      DateTime? // last time it was edited
  awbAddedById      String? // ops/staff user id who added it

  // ── domestic (India → India) ──
  // All null/false on an INTERNATIONAL shipment. Kept as their own block rather
  // than reusing the firstMile* columns because those describe a door → hub leg
  // with its own FirstMileStatus lifecycle, whereas a domestic booking is a
  // single door → door move whose progress IS the main ShipmentStatus.
  //
  // Cash on delivery is Shipmozo's own facility: the courier collects from the
  // receiver and Shipmozo remits. It is NOT how the customer pays Arena — the
  // freight is still debited from the org wallet at booking exactly like a
  // prepaid shipment. codAmount is the goods value collected from the receiver.
  codEnabled Boolean  @default(false)
  codAmount  Decimal? @db.Decimal(14, 2)

  // The door → door courier order, pushed automatically the moment the booking
  // commits (lib/inngest/functions/bookDomesticCourier.ts). Every external id is
  // written the instant the vendor returns it, so a retry after a mid-flow
  // failure resumes rather than pushing a second order.
  domesticCourierOrderId     String? // vendor's order handle
  domesticCourierWarehouseId String? // registered pickup point, reused across retries
  domesticAwbNumber          String? // courier AWB, once assigned
  domesticTrackingUrl        String? // courier's public tracking page, if any
  domesticCourierBookedAt    DateTime? // when the order was pushed to the vendor

  // Which booking adapter owns this order (lib/booking-adapters). Recorded so a
  // later label fetch, cancel or retry goes back to the vendor that actually
  // holds the order, rather than to whichever adapter happens to be default
  // once there is more than one domestic vendor.
  domesticCourierVendorId String?
  // The courier the vendor assigned, e.g. "Delhivery". Distinct from
  // selectedProductName, which is what the customer chose and paid for; they
  // agree on a normal booking and disagree only when ops force an auto-assign.
  domesticCourierName     String?
  domesticCourierStatus   DomesticCourierStatus @default(NOT_REQUIRED)
  // Why the last attempt failed, surfaced on the ops booking page. Cleared on
  // every fresh attempt so it never describes a run that has since succeeded.
  domesticCourierError    String?
  domesticCourierAttempts Int                   @default(0)
  // The AIRWAY_BILL ShipmentDocument holding the label PDF. Pointed at from here
  // rather than found by docType, because ops can upload their own airway bill
  // and the two must not be mistaken for each other.
  domesticLabelDocumentId String?
  // Arena's OWN rendering of the same waybill (lib/labels/awb), filed alongside
  // the vendor's label rather than instead of it. Both carry the courier's AWB
  // in the barcode, so either scans; they are kept side by side while we decide
  // which one to standardise on. A separate column for the same reason as the
  // one above: three AIRWAY_BILL documents can sit on one shipment (vendor's,
  // ours, and anything ops uploaded) and a docType lookup could not tell them
  // apart.
  arenaLabelDocumentId    String?

  // ── international (India → world) carrier booking ──
  // All null/NOT_REQUIRED on a DOMESTIC shipment. The mirror image of the
  // domestic* block above: the export is pushed to the vendor automatically the
  // moment the booking commits (lib/inngest/functions/bookInternationalCarrier.ts),
  // and every external id is written the instant the vendor returns it so a
  // retry after a mid-flow failure resumes rather than booking a second export.
  //
  // Kept apart from mawbNumber / hawbNumber above, which are the AIR WAYBILL
  // numbers ops type in once the airline confirms the consolidated cargo. Those
  // describe the flight; these describe our booking with the vendor. A shipment
  // can legitimately have both, and conflating them would make it impossible to
  // tell an ops-entered airline reference from a vendor-issued one.
  intlBookingVendorId String? // which adapter owns this booking (lib/booking-adapters)
  intlBookingOrderId  String? // vendor's order handle, for label / cancel / detail
  intlShipperId       String? // Shipmozo create-shipper id, reused across retries
  intlAwbNumber       String? // the vendor's waybill, once issued
  intlCarrierName     String? // the carrier actually flying it, e.g. "DHL Express"
  intlTrackingUrl     String? // the carrier's public tracking page, if any
  intlVendorPickupId  String? // vendor's own collection handle (sKart pickup_id)
  intlBookedAt        DateTime? // when the booking was placed with the vendor

  // The document URLs the vendor handed back WITH the booking, as
  // [{ kind, url }]. Persisted rather than kept in step memory because sKart
  // returns its four PDFs exactly once, from the booking call, and publishes no
  // endpoint to ask again. Without this, an ops retry days after a booking that
  // succeeded but whose label upload failed would have no way to reach the
  // label at all. Null for vendors that fetch documents by AWB (Shipmozo).
  intlVendorDocuments Json?

  intlBookingStatus   IntlBookingStatus @default(NOT_REQUIRED)
  // Why the last attempt failed, surfaced on the ops booking page. Cleared on
  // every fresh attempt so it never describes a run that has since succeeded.
  intlBookingError    String?
  intlBookingAttempts Int               @default(0)
  // The AIRWAY_BILL ShipmentDocument holding the label PDF. Pointed at from here
  // rather than found by docType, because ops can upload their own airway bill
  // and the two must not be mistaken for each other.
  intlLabelDocumentId String?

  // Per-shipment override of the resolved export profile (IEC, AD code, LUT,
  // incoterms). Ops set this when one consignment needs different papers from
  // the party's standing profile. Wins over both the client's and the org's
  // values. Null on almost every row — see lib/booking/exportProfile.ts.
  exportProfileOverride Json?

  status ShipmentStatus @default(DRAFT)

  walletTransactions WalletTransaction[]
  documents          ShipmentDocument[]
  statusHistory      ShipmentStatusEvent[]
  invoices           Invoice[]
  // The GST tax invoice Arena raises for this booking (and, later, its credit
  // note). Distinct from `invoices` above, which is Arena's manually issued
  // accounting bill. See the ShipmentInvoice model for why they are separate.
  taxInvoices        ShipmentInvoice[]

  internalNotes String? // free-form ops notes, separate from customer-facing status

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookedAt  DateTime? // set when payment succeeds / status -> BOOKED

  @@index([orgId])
  @@index([orgId, status])
  @@index([clientId])
  @@index([createdAt])
  @@index([mawbNumber])
  @@index([hawbNumber])
  // Drives the arena collections queue: "which deferred bookings still owe us?"
  @@index([paymentDeferred, paymentCollectionStatus])
  // Every list in the app is now scoped to one mode: the arena dashboard gives
  // domestic its own route, and the tenant list tabs by mode.
  @@index([mode, status])
  @@index([orgId, mode, status])
  @@index([domesticAwbNumber])
  // "Which domestic bookings have no AWB yet, or failed to get one?" — the
  // question the ops domestic queue exists to answer.
  @@index([mode, domesticCourierStatus])
}

// How far a domestic booking has got with the courier vendor. Separate from
// ShipmentStatus because they answer different questions: ShipmentStatus is
// where the parcel is, this is whether we hold a waybill for it at all. A
// booking can be BOOKED and paid while its courier order is still PENDING.
enum DomesticCourierStatus {
  NOT_REQUIRED // international shipment, or a domestic row booked before this existed
  PENDING // queued with the vendor, no AWB yet
  BOOKED // AWB assigned
  FAILED // every retry spent; needs a human
  CANCELLED // order cancelled with the vendor
}

// How far the INTERNATIONAL carrier booking has got.
//
// Deliberately a second enum with the same members rather than a reuse of
// DomesticCourierStatus. That name is on a hundred domestic call sites and
// reads as a lie on an export row; renaming it to something shared would mean
// touching the domestic flow for no behavioural gain, which is exactly the kind
// of churn that breaks a working path. Two enums, no migration risk.
enum IntlBookingStatus {
  NOT_REQUIRED // domestic shipment, or an export booked before this existed
  PENDING // queued with the vendor, no AWB yet
  BOOKED // AWB assigned
  FAILED // every retry spent; needs a human
  CANCELLED // booking cancelled with the vendor
}

// How the export moves for GST purposes. Sent to vendors as `export_type`.
enum ExportType {
  LUT // zero-rated under a Letter of Undertaking, no IGST paid up front
  BOND // moving under bond
  NA // neither applies (non-commercial, gift, sample)
}

// Who bears duty and taxes at the destination.
enum Incoterms {
  DDP // delivered duty paid — the shipper pays
  DDU // delivered duty unpaid — the receiver pays on arrival
}

// ─────────────────────────────────────────────
// PackageItem — dimensions + contents per package
// (a shipment can have multiple packages/cartons)
// ─────────────────────────────────────────────

model PackageItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // A PackageItem is a physical BOX. `quantity` = how many identical boxes
  // (same dimensions, weight and contents) — the UI tells the user to add a
  // separate box only when L/B/H, weight, OR contents differ.
  description String // short box-level summary, e.g. "Apparel carton" — derived from contents when present
  quantity    Int    @default(1)

  lengthCm Decimal @db.Decimal(8, 2)
  widthCm  Decimal @db.Decimal(8, 2)
  heightCm Decimal @db.Decimal(8, 2)
  weightKg Decimal @db.Decimal(8, 2)

  declaredValue    Decimal? @db.Decimal(14, 2) // sum of contents' value for one box (× quantity for total)
  declaredCurrency String?  @default("INR")

  hsCode String? // legacy box-level HS code; per-item HS now lives on contents

  // Items packed inside this box (Description / HSN / Qty / Price) — drives
  // the commercial invoice & customs packing list. A box can hold many items.
  contents PackageContentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
}

// ─────────────────────────────────────────────
// PackageContentItem — one line item inside a box.
// (Description / HSN / Qty / unit value) — a box can
// contain many. Powers the invoice + customs packing list.
// ─────────────────────────────────────────────

model PackageContentItem {
  id            String      @id @default(cuid())
  packageItemId String
  packageItem   PackageItem @relation(fields: [packageItemId], references: [id], onDelete: Cascade)

  description String
  hsCode      String? // HSN code for this specific item
  quantity    Int     @default(1)
  unitValue   Decimal @db.Decimal(14, 2) // price/value per unit, in `currency`
  currency    String  @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageItemId])
}

// ─────────────────────────────────────────────
// ShipmentDocument — invoice (mandatory, per-shipment)
// + ops-added docs (AWB etc.) over the shipment lifecycle
// ─────────────────────────────────────────────

model ShipmentDocument {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  docType ShipmentDocType
  label   String

  fileUrl  String
  fileKey  String
  fileName String
  fileSize Int
  mimeType String

  visibleToClient Boolean @default(true) // ops can flag internal-only docs (e.g. vendor invoices, internal correspondence)

  uploadedByType String // "ORG" | "OPS" — keep simple, avoid a second enum unless you need more roles
  uploadedById   String? // orgId's user id, or staff/ops user id, depending on uploadedByType

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shipmentId])
  @@index([shipmentId, docType])
}

// ─────────────────────────────────────────────
// ShipmentStatusEvent — audit trail / timeline.
// Every status change, who made it, optional note.
// Powers the dashboard timeline + any customer tracking view.
// ─────────────────────────────────────────────

model ShipmentStatusEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus

  note String?

  changedByType String // "ORG" | "OPS" | "SYSTEM"
  changedById   String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([shipmentId, createdAt])
}

// ─────────────────────────────────────────────
// BaApplication — tracks an Org's request to
// become a Business Associate (lower markup,
// gains access to the /clients route once approved).
// Kept even after approval, as a history record —
// don't delete on approve/reject, just update status.
// ─────────────────────────────────────────────

model BaApplication {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  status BaApplicationStatus @default(PENDING)

  // whatever you want to collect on the application form —
  // expected volume, business type, existing client base, etc.
  // kept as JSON so the form can evolve without a migration.
  formData Json?

  reviewedBy  String? // ops/admin user id who approved/rejected
  reviewedAt  DateTime?
  reviewNotes String?

  // snapshot of the markup granted on approval — copy into
  // Org.markupPercent when you flip isBusinessAssociate, but
  // keep it here too so you know what was offered vs. later changed
  approvedMarkupPercent Decimal? @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

// ─────────────────────────────────────────────
// BookingDraft — a half-finished booking, saved
// per "Save & Next" step so the user can leave and
// resume. Holds the whole wizard state as JSON plus
// the step they're on. The real Shipment + Address
// rows are only materialised at final submit, so the
// Shipment table stays 100% real bookings (no DRAFT
// clutter, no nullable address FKs).
// ─────────────────────────────────────────────

model BookingDraft {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String // Clerk user id who owns this draft

  currentStep Int  @default(0)
  data        Json // serialized BookingFormData

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One in-progress draft per user per org is the intent; enforced in the
  // action layer (find-then-update/create) rather than a DB unique, so the
  // additive push stays non-destructive.
  @@index([orgId])
  @@index([orgId, userId])
}

// ─────────────────────────────────────────────
// SystemNotice — the info banner Arena ops show
// across the tenant dashboard. Freight moves on
// events outside the app (carrier strikes, port
// congestion, rate revisions, holiday closures),
// so ops needs a way to say so without a deploy.
//
// Not org-owned: a notice is authored by Arena
// staff and targeted at an audience segment, so
// there is no orgId FK here.
// ─────────────────────────────────────────────

enum NoticeSeverity {
  INFO // neutral update — new feature, general information
  SUCCESS // resolved / good news — backlog cleared, service restored
  WARNING // heads-up that needs planning — rate revision, cut-off change
  CRITICAL // acting now matters — carrier hold, payments down
}

enum NoticeAudience {
  ALL
  BUSINESS_ASSOCIATES // orgs with isBusinessAssociate = true
  STANDARD // orgs shipping for themselves
}

enum NoticeDisplayMode {
  ALWAYS // visible from the moment it is switched on until switched off
  SCHEDULED // visible only inside the startsAt/endsAt window
}

model SystemNotice {
  id String @id @default(cuid())

  title   String? // optional short headline, e.g. "Air freight delay"
  message String // the notice body — plain text, no markup

  severity    NoticeSeverity    @default(INFO)
  audience    NoticeAudience    @default(ALL)
  displayMode NoticeDisplayMode @default(ALWAYS)

  // Kill switch, independent of the schedule. A SCHEDULED notice can be drafted
  // with isActive = false and armed later without touching its window.
  isActive Boolean @default(false)

  // false pins the notice open — used for CRITICAL notices a tenant must not be
  // able to hide (customs hold, wallet debits paused).
  dismissible Boolean @default(true)

  // Tiebreak when several notices are live at once. Higher wins.
  priority Int @default(0)

  startsAt DateTime? // SCHEDULED only; null means "from now"
  endsAt   DateTime? // SCHEDULED only; null means "until switched off"

  linkLabel String? // CTA text, e.g. "View revised rates"
  linkHref  String? // internal path ("/domestic-rates") or absolute URL

  // Bumped whenever the visible content changes. Tenant-side dismissals are
  // keyed by id + revision, so editing a live notice re-surfaces it to people
  // who already dismissed the previous wording.
  revision Int @default(1)

  createdBy String? // Clerk userId of the Arena staffer who authored it
  updatedBy String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt, isActive])
  @@index([deletedAt, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// DEFERRED PAYMENT COLLECTION
//
// Orgs with Org.skipPayment book without paying up front; the money is taken
// later, typically in cash or by UPI when the parcel reaches the hub. Before
// this, Shipment.paymentDeferred recorded that it happened but nothing recorded
// whether we were ever paid.
//
// One row per time money changes hands, rather than a single boolean, so part
// payments work and there is a permanent record of who took what. A mistaken
// entry is reversed (admin only), never deleted, so the mistake stays visible.
// ═══════════════════════════════════════════════════════════════════════════

enum PaymentCollectionStatus {
  NOT_REQUIRED // paid from the wallet at booking time, nothing is owed
  PENDING // booked without paying, nothing collected yet
  PART_PAID // some money in, a balance still owed
  COLLECTED // fully settled
  WRITTEN_OFF // ops accepted this will never be collected
}

enum PaymentCollectionMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

model PaymentCollection {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  amount   Decimal                 @db.Decimal(14, 4) // always positive
  currency String                  @default("INR")
  method   PaymentCollectionMethod

  /// UPI reference, cheque number, bank UTR — whatever proves this payment.
  reference String?
  note      String?

  /// When the money actually changed hands, which is not always when it was
  /// recorded. Ops may enter Friday's cash on Monday, and the reports should
  /// count it on Friday.
  collectedAt DateTime

  recordedByUserId String?
  recordedByName   String?

  /// Reversal is a state, not a delete. Any arena member can record a
  /// collection; only an admin can reverse one. A reversed row is excluded from
  /// every total but stays in the history with its reason attached.
  reversedAt       DateTime?
  reversedByUserId String?
  reversedByName   String?
  reversalReason   String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([reversedAt, collectedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENT-FACING EMAIL PREFERENCE
//
// See Org.clientEmailsEnabled for the full reasoning. INHERIT is the default so
// the org-wide toggle stays meaningful: only clients a BA has explicitly pinned
// stop following it.
// ═══════════════════════════════════════════════════════════════════════════

enum ClientEmailPreference {
  INHERIT // follow the org setting, whatever it is now or later
  ALWAYS // email this client even when the org setting is off
  NEVER // never email this client even when the org setting is on
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATION INBOX
//
// A durable record of things that happened, alongside (not instead of) email.
// Email reaches people who are not logged in; the inbox is the scrollable
// history that survives a deleted mail.
//
// Addressed to a SCOPE rather than to individual users. An ARENA notification is
// for whoever is on shift, and an ORG one is for whoever from that org logs in.
// Two consequences that were the point of the design:
//
//   - Somebody added to the org next month still sees everything that came
//     before, because nothing was ever fanned out to a fixed list of users.
//   - Read state is per user (NotificationReceipt), so one person opening the
//     bell does not clear the badge for their colleagues.
// ═══════════════════════════════════════════════════════════════════════════

enum NotificationScope {
  ARENA // internal ops and admin
  ORG // one tenant organisation
}

enum NotificationKind {
  // ── Arena side ──
  BOOKING_PLACED // a tenant just booked
  PAYMENT_FAILED // a top-up the bank rejected; money kind, so admin only
  COLLECTION_OVERDUE // a deferred payment nobody has collected
  SHIPMENT_STUCK // sat in the same status past the tolerance
  QUOTE_EXPIRING // a sent quote about to lapse
  COURIER_BOOKING_FAILED // a paid booking the vendor would not take — domestic courier, export carrier or first-mile pickup
  RATE_SWEEP_DEGRADED // the scheduled rate sweep finished with a vendor failing too much of its matrix

  // ── Tenant side ──
  SHIPMENT_STATUS // their shipment moved
  ARENA_MESSAGE // ops wrote to them directly
}

model Notification {
  id String @id @default(cuid())

  scope NotificationScope
  /// Required for ORG scope, always null for ARENA. Enforced in lib/notifications/emit.ts.
  orgId String?
  org   Org?              @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind     NotificationKind
  /// Reuses the notice palette so a warning looks the same everywhere in the app.
  severity NoticeSeverity   @default(INFO)

  title String
  body  String?

  /// Where the row takes you. In-app path only, validated before it is written.
  linkHref String?

  // ARENA scope only. Money figures are hidden from non-admin arena members
  // everywhere else, so a notification carrying an amount must not turn up in an
  // ops member's inbox and reintroduce the leak by the back door.
  adminOnly Boolean @default(false)

  // Natural key for anything a scheduled job re-evaluates on every run. The job
  // computes the same key for the same real-world fact, so the unique constraint
  // turns a repeat run into a no-op instead of a duplicate row. Null for events
  // that fire exactly once by nature, like a booking being placed.
  dedupeKey String? @unique

  /// Set when the notification is about one shipment, for the link and for cleanup.
  shipmentId String?
  /// Clerk userId when a human authored this, null when the system did.
  createdBy  String?

  createdAt DateTime @default(now())

  receipts NotificationReceipt[]

  // Covers the two inbox reads: the arena feed and one org's feed. createdAt is
  // in the index because every read is "newest first".
  @@index([scope, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([kind, createdAt])
}

model NotificationReceipt {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// Clerk userId. Not a relation: users live in Clerk, not here.
  userId String

  // A row existing IS the read mark. Written when someone opens the bell or hits
  // "mark all as read", never in advance, so the table only grows with actual
  // reads rather than with (notifications x members).
  readAt DateTime @default(now())

  // The pair is the identity, so the upsert needs no surrogate key and the
  // "have I read this" lookup is served by the primary key index alone.
  @@id([notificationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Invoice
// ---------------------------------------------------------------------------
//
// A billing document Arena issues TO a customer org. Distinct from
// ShipmentDocument.INVOICE, which is the customer's own commercial invoice for
// customs. This is Arena's bill for the service: a real PDF (uploaded by an
// Arena admin) plus the money it represents.
//
// invoiceNumber is entered by the admin — it mirrors the number printed on the
// PDF that comes out of their accounting system, so it is the source of truth
// rather than something we mint. Unique across the whole platform, the way a
// business's own invoice numbers already are.
//
// shipmentId is optional: most invoices bill for one shipment, but a
// consolidated/standalone invoice (e.g. a monthly bill) has none. Set null on
// shipment deletion so voiding a shipment never erases the money owed.
//
// OVERDUE is NOT stored: it is derived (status == UNPAID && dueDate < now) so
// there is no clock to keep flipping. Admins only ever set UNPAID / PAID /
// CANCELLED; the UI shows "Overdue" on top of an unpaid, past-due row.
model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("INR")
  status   InvoiceStatus @default(UNPAID)

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  notes     String?

  // ── file (the invoice PDF) ──
  fileUrl  String
  fileKey  String
  fileName String
  fileSize Int
  mimeType String

  // ── audit: who issued it, who marked it paid ──
  createdById   String? // Clerk user id of the Arena admin who uploaded it
  createdByName String? // stamped display name, survives the admin leaving
  paidAt        DateTime?
  paidById      String?
  paidByName    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orgId])
  @@index([orgId, status])
  @@index([shipmentId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED // voided by an admin; kept for the record, never deleted
}

// ---------------------------------------------------------------------------
// ShipmentInvoice — the GST tax invoice Arena raises for a booking
// ---------------------------------------------------------------------------
//
// Deliberately NOT the Invoice model above. That one is an admin uploading a
// PDF from Arena's accounting system, with a number typed in by hand. This one
// is minted by the platform the moment a shipment is booked, and every rule
// about it is different: the number comes from a gapless counter, the row is
// never edited, and it is never deleted. Sharing a table would mean every
// action in the invoice layer branching on which kind it was holding.
//
// One row per (shipment, docType), which is also the idempotency key: the
// background job that renders the PDF can run twice and produce one invoice.
//
// EVERYTHING PRINTED IS SNAPSHOTTED. A tax invoice is a statement about a
// moment. If the org renames itself, corrects its GSTIN or edits an address
// next month, the document it already holds must not silently disagree with
// the copy we can regenerate. So seller, buyer, shipment and line items are
// frozen as JSON at issue time and the PDF is rendered from those, never from
// a live join.
//
// NO deletedAt. An issued tax invoice cannot be withdrawn from existence; the
// correction path is a credit note (docType CREDIT_NOTE, relatedInvoiceId set),
// which is why those two columns exist before the credit-note template does.
model ShipmentInvoice {
  id String @id @default(cuid())

  // Null until the background job allocates it. Nothing is legally issued
  // without a number, so this staying null is exactly what "not yet issued"
  // means. Allocation happens as late as possible so a render that fails on
  // every retry cannot burn a serial and leave a hole in the series.
  invoiceNumber String? @unique

  docType TaxDocType @default(TAX_INVOICE)

  // Only set on a CREDIT_NOTE: the invoice it reverses.
  relatedInvoiceId String?
  relatedInvoice   ShipmentInvoice?  @relation("InvoiceCorrection", fields: [relatedInvoiceId], references: [id], onDelete: Restrict)
  corrections      ShipmentInvoice[] @relation("InvoiceCorrection")

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Required, unlike Invoice.shipmentId. This document only exists because a
  // shipment was booked; there is no standalone case. Restrict rather than
  // Cascade: deleting a shipment must not take an issued tax document with it.
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  // The tax point: when the booking was committed, not when the PDF finished
  // rendering. The financial year of the invoice number is derived from THIS,
  // so a job that runs a few seconds past midnight on 1 April still numbers
  // the invoice into the year the money actually moved.
  issueDate     DateTime @default(now())
  financialYear String? // "26-27", stamped alongside the number

  // ── money (INR, 2dp — the currency a GST invoice is raised in) ──
  // total ALWAYS equals the amount debited from the wallet for this booking
  // (service price + first-mile charge). Everything else is derived from it:
  // the prices customers see are tax-inclusive, so taxableValue is
  // back-computed and the line items are reconciled to sum to it exactly.
  // See lib/invoices/money.ts for the arithmetic and its invariants.
  taxableValue   Decimal @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @db.Decimal(14, 2)
  totalTax       Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  currency       String  @default("INR")
  /// Printed when no tax is charged, e.g. an export exemption citation.
  taxNote        String?

  // ── place of supply (2-digit GST state code + name, both printed) ──
  placeOfSupplyCode String
  placeOfSupplyName String

  // ── frozen document content ──
  /// Arena's issuer block: legal name, address, GSTIN, PAN, bank details.
  sellerSnapshot   Json
  /// Bill-to block: org legal name, address, GSTIN or "Unregistered".
  buyerSnapshot    Json
  /// Route, packages, weight, service, and the consignor when a BA booked.
  shipmentSnapshot Json
  /// The reconciled charge lines, each with description, SAC and amounts.
  lineItems        Json

  status ShipmentInvoiceStatus @default(UNPAID)
  paidAt DateTime?

  // ── PDF generation (the background job's own state) ──
  // Kept on the row rather than inferred from fileUrl being null, so a job
  // that has exhausted its retries is distinguishable from one still queued
  // and an admin can find and re-drive exactly the broken ones.
  generationStatus   InvoiceGenerationStatus @default(PENDING)
  generationError    String?
  generationAttempts Int                     @default(0)
  generatedAt        DateTime?

  // Null until the render lands. Same column shape as ShipmentDocument and
  // Invoice so the download UI treats all three identically.
  fileUrl  String?
  fileKey  String?
  fileName String?
  fileSize Int?
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One tax invoice and at most one credit note per shipment. This is what
  // makes the generation job safe to retry.
  @@unique([shipmentId, docType])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, issueDate(sort: Desc)])
  @@index([shipmentId])
  // Drives the admin "which invoices are stuck?" view and the repair path.
  @@index([generationStatus])
  @@index([financialYear])
}

enum ShipmentInvoiceStatus {
  PAID // wallet was debited at booking
  UNPAID // Org.skipPayment booking, collected at the hub later
  CANCELLED // booking voided; the PDF and number survive for the record
}

enum InvoiceGenerationStatus {
  PENDING // row committed with the booking, PDF not rendered yet
  READY // numbered, rendered, uploaded
  FAILED // retries exhausted; an admin can re-drive it
}

enum TaxDocType {
  TAX_INVOICE
  CREDIT_NOTE
}

// ---------------------------------------------------------------------------
// InvoiceCounter — the gapless serial behind every invoice number
// ---------------------------------------------------------------------------
//
// GST wants a consecutive serial, unique within a financial year. A Postgres
// sequence cannot provide that: nextval() is deliberately non-transactional, so
// any rollback after it is called leaves a permanent hole in the series, which
// is the first thing an auditor asks about. shipment_number_seq accepts that
// trade for speed because a missing shipment number costs nothing.
//
// This is a plain row taken with SELECT ... FOR UPDATE inside the issuing
// transaction. Concurrent bookings serialise on it and a rollback returns the
// number to the pool. The lock is held for microseconds and only against other
// invoice issues, so the contention is irrelevant at any volume Arena will see.
//
// One row per (series, financialYear). Rows are created on demand by an upsert,
// so the first booking of a new financial year needs no migration or seeding.
model InvoiceCounter {
  id String @id @default(cuid())

  /// Matches TaxDocType. Tax invoices and credit notes number independently.
  series        String
  /// Indian financial year, April to March, formatted "26-27".
  financialYear String

  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([series, financialYear])
}

// ---------------------------------------------------------------------------
// MANUAL INVOICING — off-platform work, billed by hand
// ---------------------------------------------------------------------------
//
// Most of Arena's business never touches the booking flow: a customer calls, a
// consignment moves, and somebody has to produce a proper GST tax invoice for
// it. These models are that tool. See manualInvoicing.md for the decisions.
//
// Deliberately NOT ShipmentInvoice. That one is minted by the platform from a
// booked Shipment and an authoritative wallet debit, and every rule about it
// follows from those two facts. This one is typed by an admin, has no shipment,
// and adds tax on top of what was typed. Sharing a table would put a branch on
// that distinction in every function in the invoice layer.

// ---------------------------------------------------------------------------
// BillingParty — the address book of people Arena bills
// ---------------------------------------------------------------------------
//
// Everything else in the invoice layer hangs off an Org, because everything
// else began with somebody signing up. Off-platform customers have no account
// and most never will. Inventing a shell Org for each one would fill the tenant
// tables with rows that can never log in and would show up in every org count,
// list and export.
//
// So this is a plain party record. It CAN be linked to an Org or a Client when
// one happens to match, and when it is linked to an Org the issued invoice also
// appears in that customer's own /invoices tab. When it is not, the PDF is the
// whole delivery and nobody logs in to see it.
/// Whether the party being billed is a company or a person.
///
/// Not cosmetic. An individual has no GSTIN, no CIN and no trading name, and a
/// form that asks for them anyway reads as though the invoice cannot be raised
/// without them. It also changes the document: a company with no GSTIN is
/// meaningfully "unregistered" and worth stating, whereas printing
/// "GSTIN: Unregistered" against a person's name is noise.
enum BillingPartyKind {
  BUSINESS
  INDIVIDUAL
}

model BillingParty {
  id String @id @default(cuid())

  /// BUSINESS unless someone says otherwise, because almost every party is one
  /// and every party that existed before this column was added is one.
  kind BillingPartyKind @default(BUSINESS)

  /// Printed as the bill-to name. The registered legal name for a business, the
  /// person's full name for an individual.
  legalName    String
  /// Optional trading name, printed beneath the legal one when they differ.
  tradeName    String?
  /// The customer's code in Arena's own accounting system, if they have one.
  customerCode String?

  gstin String?
  pan   String?
  cin   String?

  contactName String?
  email       String?
  phone       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  /// Free text, as typed. stateCode below is the authoritative one.
  state        String?
  /// Two-digit GST state code. Decides IGST vs CGST/SGST on every invoice
  /// raised to this party, so it is resolved from the GSTIN when there is one.
  stateCode    String?
  postalCode   String?
  country      String? @default("India")

  notes String?

  // ── optional links back into the platform ──
  // Both nullable and both SetNull: a party outlives the account it was once
  // matched to. Losing the link must never lose the billing history.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Convenience defaults remembered from the last invoice raised to this
  /// party: currency, tax mode, payment terms, place of supply, and the charge
  /// types that were used. Picking a party fills roughly half the form, which
  /// is the single largest contributor to the five-minute target.
  ///
  /// JSON rather than columns because the set of things worth remembering will
  /// change as the tool is used, and none of it is authoritative: a default
  /// seeds a form field, and the field is what gets snapshotted onto the
  /// document. Nothing here is ever printed straight.
  defaults Json?

  invoices ManualInvoice[]

  createdById   String?
  createdByName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([legalName])
  @@index([gstin])
  @@index([orgId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ChargeType — the catalog behind the charge picker
// ---------------------------------------------------------------------------
//
// A table rather than a constant because vendors invent surcharges faster than
// anyone ships code, and an admin who cannot bill something will work around
// the tool rather than wait for a deploy.
//
// `applicability` filters what the picker offers FIRST; it never restricts what
// can be billed. A charge marked international still appears on a domestic
// invoice if you search for it by name. A catalog that refuses is a catalog
// people route around.
model ChargeType {
  id String @id @default(cuid())

  /// Stable kebab-case key, e.g. "fuel-surcharge". The seed upserts on this,
  /// so re-running it never duplicates a row or overwrites an edited rate.
  code        String  @unique
  /// What prints on the invoice line.
  label       String
  /// Longer wording for the picker, when the label alone is ambiguous.
  description String?

  /// Services Accounting Code defaulted onto the line so an admin never types
  /// one. Overridable per line.
  sacCode            String  @default("996812")
  /// Default GST rate for this charge, in percent. Overridable per line.
  defaultRatePercent Decimal @default(18) @db.Decimal(5, 2)

  /// True for charges that are normally money Arena pays out and recovers
  /// (destination duty, origin country taxes, airline DO). Seeds the line's
  /// reimbursement flag, which keeps the amount out of taxable value and out
  /// of every tax head. See manualInvoiceMoney.
  defaultReimbursement Boolean @default(false)

  applicability ChargeApplicability @default(ANY)

  charges ManualInvoiceCharge[]

  /// Picker ordering. Lower sorts first, so freight and fuel surcharge sit at
  /// the top where they are needed on almost every invoice.
  sortOrder Int @default(500)

  /// Seeded rows are marked so the seed can tell its own rows from an admin's
  /// and never clobber the latter.
  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([applicability])
}

enum ChargeApplicability {
  ANY
  DOMESTIC
  INTERNATIONAL
  AIR
  SEA
}

// ---------------------------------------------------------------------------
// ChargePreset — a named bundle of charge lines
// ---------------------------------------------------------------------------
//
// "Air export commercial" pre-loads freight, fuel surcharge, AHS,
// documentation and customs clearance with their SACs and zero amounts, so the
// admin fills numbers only. The second half of the five-minute target, after
// duplicating a previous invoice.
model ChargePreset {
  id String @id @default(cuid())

  name        String  @unique
  description String?

  /// Array of { chargeTypeCode, label, sacCode, ratePercent, reimbursement }.
  /// Denormalised on purpose: a preset is a starting point, and a charge type
  /// later renamed or deactivated must not silently change what an old preset
  /// lays down or make it fail to load at all.
  lines Json

  mode ShipmentMode?

  sortOrder Int @default(500)

  createdById   String?
  createdByName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt, sortOrder])
}

// ---------------------------------------------------------------------------
// ManualInvoice — the document
// ---------------------------------------------------------------------------
//
// A DRAFT is a live, editable working area: no number, no snapshot, no PDF, and
// it reads from the consignment and charge rows below. Issuing allocates the
// serial, freezes everything printed into the JSON columns, renders the PDF,
// and makes the row immutable.
//
// EVERYTHING PRINTED IS SNAPSHOTTED, for the same reason as ShipmentInvoice: a
// tax invoice is a statement about a moment, and the customer is holding a copy.
// Correcting a party's GSTIN next month must not rewrite the invoice they
// already have. The renderer reads only the frozen JSON, never a live join.
model ManualInvoice {
  id String @id @default(cuid())

  /// Null while DRAFT. Allocated on issue and never reused. Nothing is legally
  /// issued without a number, so null is exactly what "not yet issued" means.
  invoiceNumber String? @unique
  /// "26-27", stamped alongside the number.
  financialYear String?

  docType ManualInvoiceDocType @default(TAX_INVOICE)

  /// Only set on a CREDIT_NOTE: the invoice it reverses. Restrict, because an
  /// invoice with a credit note against it cannot be made to disappear.
  relatedInvoiceId String?
  relatedInvoice   ManualInvoice?  @relation("ManualInvoiceCorrection", fields: [relatedInvoiceId], references: [id], onDelete: Restrict)
  corrections      ManualInvoice[] @relation("ManualInvoiceCorrection")

  // ── who is billed ──
  // Restrict rather than Cascade: deleting a party must not take issued tax
  // documents with it. The party delete path soft-deletes for this reason.
  billingPartyId String
  billingParty   BillingParty @relation(fields: [billingPartyId], references: [id], onDelete: Restrict)

  /// Denormalised from the party at issue time so the tenant-side list can be
  /// scoped without walking through BillingParty, and so unlinking a party from
  /// its org later does not retroactively hide invoices that org has seen.
  orgId String?
  org   Org?    @relation(fields: [orgId], references: [id], onDelete: SetNull)

  status      ManualInvoiceStatus @default(DRAFT)
  /// Domestic or international. Drives default terms and which charge types the
  /// picker offers first. Not a tax decision: the rate is per line.
  mode        ShipmentMode        @default(INTERNATIONAL)
  /// CSB-4 / CSB-5 / commercial. A label for filtering, printed in the shipment
  /// block, changing nothing about the money.
  csbCategory String?

  issueDate    DateTime  @default(now())
  dueDate      DateTime?
  /// One of the values in lib/invoices/manual/config.ts, e.g. "NET_30".
  paymentTerms String?

  /// Free-text reference the customer asked for on their bill (a PO number,
  /// their own job reference). Printed in the invoice details block.
  reference String?

  // ── tax posture ──
  /// EXCLUSIVE adds GST to what was typed; INCLUSIVE splits it out of the typed
  /// gross. One switch, one branch in the money engine, invariants hold both
  /// ways. See manualInvoicing.md §4.
  taxMode       TaxMode @default(EXCLUSIVE)
  /// Printed and stated; true means the recipient pays the GST, so no tax is
  /// charged on the document.
  reverseCharge Boolean @default(false)

  placeOfSupplyCode String?
  placeOfSupplyName String?

  // ── money, in the invoice currency ──
  // Populated on issue from the charge rows and re-verified before persisting.
  // A draft carries running totals so the list is readable, but the issue path
  // rebuilds them from the rows rather than trusting these.
  currency       String  @default("INR")
  /// Sum of non-reimbursement lines, pre-tax.
  taxableValue   Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @db.Decimal(14, 2)
  totalTax       Decimal @default(0) @db.Decimal(14, 2)
  /// Pure-agent recoveries. In the total, outside the taxable value and outside
  /// every tax head.
  reimbursements Decimal @default(0) @db.Decimal(14, 2)
  /// taxableValue + totalTax + reimbursements. What the customer owes.
  total          Decimal @default(0) @db.Decimal(14, 2)
  /// Printed when nothing is charged, e.g. a reverse-charge or export citation.
  taxNote        String?

  // ── e-invoicing (optional, pasted by hand) ──
  // No IRP integration. An admin generates the IRN on the government portal and
  // pastes it back; the PDF prints the QR when one is present.
  irn        String?
  irnAckNo   String?
  irnAckDate DateTime?
  /// The signed QR payload, rendered to a QR code on the document.
  irnQrData  String?   @db.Text

  notes         String?
  /// Overrides the mode's default terms when an admin needs different ones.
  termsOverride String? @db.Text

  // ── frozen document content (null while DRAFT) ──
  /// Arena's issuer block, a copy of the same config the booking invoices use.
  sellerSnapshot      Json?
  /// Bill-to block as it stood at issue.
  buyerSnapshot       Json?
  /// Consignments as printed, with their per-consignment charge lines.
  consignmentSnapshot Json?
  /// The rolled-up, taxed service lines. What the charges table prints.
  lineItems           Json?

  // ── the PDF ──
  // Same column shape as ShipmentDocument, Invoice and ShipmentInvoice so the
  // download UI treats all of them identically.
  fileUrl  String?
  fileKey  String?
  fileName String?
  fileSize Int?
  mimeType String?

  issuedAt   DateTime?
  paidAt     DateTime?
  paidById   String?
  paidByName String?

  /// Set when the PDF was last emailed to the party, so the list can show
  /// whether the customer has actually been sent their invoice.
  lastSentAt DateTime?
  lastSentTo String?

  cancelledAt     DateTime?
  cancelledReason String?

  createdById   String?
  createdByName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Drafts are deletable. Once issued, deletedAt stays null forever: the
  /// correction path is a credit note.
  deletedAt DateTime?

  consignments ManualInvoiceConsignment[]

  @@index([status])
  @@index([billingPartyId])
  @@index([orgId, status])
  @@index([issueDate(sort: Desc)])
  @@index([financialYear])
  @@index([deletedAt])
  @@index([createdAt])
}

enum ManualInvoiceStatus {
  DRAFT // no number, no PDF, freely editable
  ISSUED // numbered, rendered, immutable, unpaid
  PAID
  CANCELLED // voided; the number and PDF survive for the record
  // OVERDUE is NOT here. It is derived (ISSUED && dueDate < now) in
  // deriveManualInvoiceView, the same call the account-bill list already makes.
}

enum ManualInvoiceDocType {
  TAX_INVOICE
  CREDIT_NOTE
}

enum TaxMode {
  /// Typed amounts are pre-tax; GST is added and the total grows.
  EXCLUSIVE
  /// Typed amounts are gross; GST is split out of them and the total is
  /// exactly what was typed.
  INCLUSIVE
}

// ---------------------------------------------------------------------------
// ManualInvoiceConsignment — one AWB on the invoice
// ---------------------------------------------------------------------------
//
// An invoice can bill several consignments at once, which is what monthly
// billing of a regular customer looks like. Every field is optional except the
// ordering, because an invoice for warehousing or a documentation fee has no
// AWB, no route and no weight, and forcing placeholder values onto it would put
// fiction on a tax document.
model ManualInvoiceConsignment {
  id String @id @default(cuid())

  invoiceId String
  invoice   ManualInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Position on the document. The S.No column.
  sortOrder Int @default(0)

  /// House air waybill, or the courier's tracking number.
  awbNumber      String?
  /// Master air waybill, for consolidated air freight.
  mawbNumber     String?
  /// The number the customer tracks on, when it is not the HAWB. A courier
  /// consignment often carries both: the AWB the airline flew it under, and a
  /// separate tracking number the customer was given. Printing one where the
  /// other was expected is how a customer is told to track a number that does
  /// not resolve, so they are two fields.
  trackingNumber String?
  bookingDate    DateTime?
  /// When the goods were actually collected, which is not always the day they
  /// were booked and is the date a customer reconciles their own dispatch
  /// register against.
  pickupDate     DateTime?

  // ── route ──
  //
  // `origin` and `destination` are what PRINTS: a composed label like
  // "Gurugram, Haryana" or "Dubai, United Arab Emirates". They stay free text
  // and stay editable, because a lane is sometimes a port, a hub or a customer's
  // own wording, and forcing every one through a pincode would block an invoice
  // on a lookup that was never going to succeed.
  //
  // The structured fields beneath them are the record. They are filled by the
  // pincode lookup (utils/postalLookup.ts, the same India Post and Zippopotam
  // path the booking flow uses) and are what any later lane report has to read,
  // because "Gurugram, Haryana" cannot be grouped and a state code can.
  origin      String?
  destination String?

  originPostalCode String?
  originCity       String?
  originState      String?
  originCountry    String?

  destinationPostalCode String?
  destinationCity       String?
  destinationState      String?
  destinationCountry    String?

  /// "Express", "Air freight", "Sea LCL". Free text: the service names Arena
  /// sells off-platform are not the platform's service catalog.
  serviceType     String?
  /// The product sold, as the CARRIER names it: "UPS Saver", "Express
  /// Worldwide", "International Priority". Free text for the same reason
  /// serviceType is, and read together with forwarderName rather than alone:
  /// the picker offers the products already used under the chosen forwarder,
  /// grouped on it. "Saver" under FedEx would be somebody else's word.
  productType     String?
  /// "Documents", "Non-documents", "Sample". What customs and the carrier both
  /// ask for, and what decides which papers a consignment needs.
  parcelType      String?
  /// How it travelled: Air, Sea, Surface, Rail. Deliberately NOT the invoice's
  /// own `mode` column, which says domestic or international. A domestic
  /// consignment can move by air and an international one by sea, and one field
  /// cannot say both.
  shipMode        String?
  /// Airport or port codes, when the lane is freight rather than courier.
  originPort      String?
  destinationPort String?
  flightNumber    String?

  /// Carrier or airline the consignment flew on. Printed as given; this is
  /// Arena's own record of an off-platform move, not a rate sourced through the
  /// platform, so carrierBranding.md's vendor-disclosure rule does not bite.
  airlineName   String?
  /// Who carried it: DHL, FedEx, UPS, Aramex, Blue Dart. Printed first in the
  /// consignment block, ahead of the service description, because it is the
  /// half of "DHL, Express Worldwide" the customer recognises.
  ///
  /// Naming the vendor here does NOT breach carrierBranding.md. That rule is
  /// about rates sourced THROUGH the platform, where the vendor is an
  /// implementation detail the customer never chose. A manual invoice is
  /// Arena's record of an off-platform move, and who flew it is a thing the
  /// customer asked for. Same reasoning as airlineName above.
  forwarderName String?
  /// The agent at the far end, when there was one.
  subAgent      String?

  /// Total No of Packages on the customer's paperwork.
  pieces             Int?
  grossWeightKg      Decimal? @db.Decimal(10, 3)
  chargeableWeightKg Decimal? @db.Decimal(10, 3)

  /// Package breakdown, when the customer's own paperwork states it this way.
  /// Separate from `pieces` because a consignment of 3 pallets holding 40
  /// cartons is two true numbers, and collapsing them loses the one the
  /// warehouse actually counted.
  boxCount    Int?
  palletCount Int?
  cartonCount Int?

  goodsDescription String?
  /// HSN of the goods, typed in rather than derived.
  ///
  /// A manual invoice records an off-platform move and holds no item list, so
  /// there is nothing here with a quantity to pick a code from. On the booking
  /// invoice the same figure comes from the box contents automatically, taking
  /// the HS code of the item with the largest quantity. Both print it in the
  /// consignment block; only this one asks a human for it.
  ///
  /// It describes the CARGO, not the supply. What Arena is billing for is a
  /// freight service and its code is the SAC in the charges table. Do not merge
  /// the two: they answer different questions and one is not a fallback for the
  /// other.
  hsnCode          String?
  /// Free-text "Particulars" line, for anything the columns do not hold.
  particulars      String?
  /// The customer's own export invoice number, printed as "Shipper invoice no."
  /// It is the number their bank will ask for.
  exportInvoiceNo  String?
  /// The customer's reference for this consignment, distinct from the
  /// invoice-wide reference and from Arena's job number.
  referenceNo      String?
  shipperName      String?
  consigneeName    String?
  containerNumber  String?
  jobNumber        String?

  notes String?

  charges ManualInvoiceCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, sortOrder])
}

// ---------------------------------------------------------------------------
// ManualInvoiceCharge — one billed line, under one consignment
// ---------------------------------------------------------------------------
//
// Charges belong to a consignment rather than to the invoice, so "what did that
// one AWB cost" stays answerable. The taxed table printed on the document is a
// roll-up of these grouped by label, SAC and rate.
model ManualInvoiceCharge {
  id String @id @default(cuid())

  consignmentId String
  consignment   ManualInvoiceConsignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  /// The catalog row this came from, for reporting. Nullable and SetNull: the
  /// label, SAC and rate are copied onto the line below, so a deleted or
  /// renamed charge type cannot change what an invoice says.
  chargeTypeId String?
  chargeType   ChargeType? @relation(fields: [chargeTypeId], references: [id], onDelete: SetNull)

  /// What prints. Copied from the catalog at pick time, editable after.
  label   String
  sacCode String @default("996812")

  /// Unit price and quantity, so the document can show the working. The billed
  /// figure is `amount`, which is stored rather than derived: a rate of 4097.11
  /// times a quantity of 3 is not a figure anyone wants recomputed with a
  /// different rounding rule than the one the admin saw.
  rate     Decimal @default(0) @db.Decimal(14, 2)
  quantity Decimal @default(1) @db.Decimal(10, 3)
  amount   Decimal @default(0) @db.Decimal(14, 2)
  /// Subtracted from amount before tax. Stored as a positive number.
  discount Decimal @default(0) @db.Decimal(14, 2)

  /// Per line, defaulted from the catalog. A single invoice-wide rate could not
  /// express a bill mixing 18% service charges with a zero-rated item, and every
  /// real freight invoice mixes them eventually.
  ratePercent Decimal @default(18) @db.Decimal(5, 2)

  /// Pure-agent recovery: money Arena paid out and is recovering, not revenue.
  /// Excluded from taxable value and from every tax head, printed in its own
  /// subtotal, still owed by the customer. Charging GST on recovered duty for a
  /// year means a year of credit notes, so this flag matters more than its size
  /// suggests.
  reimbursement Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consignmentId, sortOrder])
  @@index([chargeTypeId])
}

// ---------------------------------------------------------------------------
// International rate sweep
// ---------------------------------------------------------------------------
//
// WHY THIS EXISTS
// Every international vendor API prices exactly one shipment per call: one
// destination, one weight, one box. A quotation that spans twelve countries and
// twenty weights is two hundred and forty calls, which is not something anyone
// can wait for and not something the vendors would tolerate at that rate during
// business hours.
//
// So the calls are made on a schedule instead, every fifth night, and the
// answers are kept. A quotation then becomes a query over a table we own, which
// is the difference between "pick a country and wait" and "here is the whole
// grid, sorted however you like".
//
// WHAT THESE NUMBERS ARE, AND ARE NOT
// Raw vendor cost. No markup, ever. Markup is an org-level number applied at
// read time in lib/services/rate-calculator.service.ts, and a marked-up figure
// cached here would be wrong for every other org and silently wrong forever.
//
// They are also INDICATIVE. Up to five days old, quoted from one canonical
// postcode per country against a synthetic box. Good enough to build a
// quotation sheet a customer can plan against, not good enough to charge from.
// Bookings price live, and that is not an optimisation left undone.
//
// THE FOUR TABLES
//   RateSweepRun       one execution of the whole matrix
//   RateSweepCall      one API call: run x vendor x country x weight
//   VendorRateSnapshot one PRODUCT returned by a call (vendors return several)
//   VendorRateCharge   one line of one product's breakdown
//
// Calls and snapshots are separate because a call that returns nothing is still
// a fact worth keeping: "sKart does not fly 40kg to Brasília" is an answer, and
// storing it stops the next sweep, and the sweep after that, from asking again
// as though nobody had ever checked.
//
// Charges are rows rather than a JSON blob for one reason: `group by
// canonicalName over capturedAt` is the analysis this whole system exists to
// make possible. Watching a fuel surcharge move across six months is a plain
// SQL query against this table and an unreadable JSON traversal against the
// alternative.

/// Where a sweep came from. Manual runs are re-drives an admin asked for.
enum RateSweepTrigger {
  CRON
  MANUAL
}

enum RateSweepStatus {
  RUNNING
  /// Every lane finished and the failure rate stayed inside tolerance.
  COMPLETED
  /// Finished, but at least one vendor failed enough of its lanes to be worth
  /// a person looking. Still usable data; the good lanes are still good.
  PARTIAL
  /// Could not be run or could not be finished. No usable data.
  FAILED
}

/// Whether a quoted price includes destination duties and taxes. Parsed from
/// the vendor's service label by lib/rateSweep/carrier.ts.
///
/// This is not a cosmetic attribute: ranking a DUTY_UNPAID rate against a
/// DUTY_PAID one makes the unpaid rate look cheaper and leaves the customer a
/// customs bill on delivery. Every fair comparison filters on it.
enum RateDutyMode {
  DUTY_PAID
  DUTY_UNPAID
  /// The label did not say. Most services do not, so this is the common case
  /// and it means "unknown", never "unpaid".
  UNKNOWN
}

/// Whether a service carries documents or goods. Vendors price the two
/// differently and several publish both under near-identical names.
enum RateContentType {
  DOCUMENTS
  NON_DOCUMENTS
  UNKNOWN
}

/// The outcome of one vendor call, classified so a query can tell a lane that
/// does not exist from a vendor that was down. See lib/rate-adapters/core/errors.ts.
enum RateSweepCallStatus {
  /// At least one quote came back.
  OK
  /// The vendor answered and declined the lane. Not a fault. Do not retry.
  NO_SERVICE
  /// 5xx, malformed body, socket failure. Transient, worth retrying.
  VENDOR_ERROR
  /// Credentials rejected. The sweep stops this vendor for the rest of the run.
  AUTH_ERROR
  /// 429. Backed off and continued at a slower pace.
  RATE_LIMITED
  /// No response inside the timeout.
  TIMEOUT
  /// Missing credentials or bad config on our side, not the vendor's.
  CONFIG_ERROR
  /// Never attempted, because the vendor had already been stopped for this run.
  SKIPPED
}

model RateSweepRun {
  id String @id @default(cuid())

  trigger     RateSweepTrigger @default(CRON)
  /// Clerk userId for a manual re-drive, null for the cron.
  triggeredBy String?

  status RateSweepStatus @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Bumped in lib/rateSweep/config.ts whenever the matrix definition changes
  /// in a way that makes rows incomparable across runs (a slab moved, a
  /// canonical postcode changed, the box formula changed). Without it, a trend
  /// line silently mixes two different questions.
  configVersion String

  /// The full matrix definition this run used, verbatim: countries and their
  /// canonical postcodes, the weight ladder, the box formula, the Shipmozo
  /// purpose and declared value. Denormalised on purpose. In two years the
  /// config file will have moved on and this is the only record of what the
  /// numbers in this run actually mean.
  config Json

  originPincode String
  originCity    String

  /// Resolved from the adapter registry at plan time, not hardcoded, so a
  /// vendor added later is swept without touching this job.
  vendorIds String[]

  /// vendors x countries. One Inngest run each.
  laneCount      Int @default(0)
  /// Atomically incremented by each lane as it finishes, success or failure.
  /// When it reaches laneCount the last lane fires the finalise event, which is
  /// why it is a counter and not a derived count: a derived count over a table
  /// this size, polled, is the version of this that does not scale.
  lanesCompleted Int @default(0)
  lanesFailed    Int @default(0)

  plannedCalls  Int @default(0)
  okCalls       Int @default(0)
  failedCalls   Int @default(0)
  /// Product rows written. Always >= okCalls, since one call yields several.
  snapshotCount Int @default(0)

  /// Set when the run ended abnormally, or when finalise had something to say.
  notes String?

  calls      RateSweepCall[]
  snapshots  VendorRateSnapshot[]
  quotations RateQuotation[]

  @@index([status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

model RateSweepCall {
  id String @id @default(cuid())

  runId String
  run   RateSweepRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  vendorId   String
  vendorName String

  // ── The exact question that was asked ──
  originPincode     String
  destCountryCode   String  @db.Char(2)
  destCity          String
  destPostcode      String
  /// True for destinations with no postal system (UAE, Qatar), where a
  /// placeholder was sent because the vendor's API demands the field. If those
  /// lanes come back empty, this is the first thing to check.
  syntheticPostcode Boolean @default(false)

  /// Chargeable weight in kg. The row key, and the axis every query groups on.
  weightKg Decimal @db.Decimal(10, 3)

  /// Which box formula produced the dimensions below. "cube-half-vol" today.
  /// Present so bulky-shipment profiles can be added later without re-keying
  /// every existing row.
  boxProfile  String
  boxLengthCm Decimal @db.Decimal(8, 2)
  boxWidthCm  Decimal @db.Decimal(8, 2)
  boxHeightCm Decimal @db.Decimal(8, 2)

  /// Shipmozo alone prices on these. Stored for every vendor anyway, so a row
  /// is self-describing without the reader knowing which vendor cares.
  shipmentPurpose String
  declaredValue   Decimal @db.Decimal(14, 2)

  // ── What came back ──
  status       RateSweepCallStatus
  httpStatus   Int?
  /// The RateErrorKind, kept as text rather than an enum so a new kind in the
  /// code does not need a migration before it can be recorded.
  errorKind    String?
  errorMessage String?

  /// How many times the durable retry had to run this before it settled.
  attempts  Int  @default(1)
  latencyMs Int?

  /// Products returned. Zero on every non-OK status.
  quoteCount Int @default(0)

  /// The vendor's response, verbatim, for re-deriving a breakdown after a
  /// parsing fix and for answering questions this schema did not anticipate.
  ///
  /// NOTE THE ABSENCE OF A REQUEST PAYLOAD. sKart authenticates by putting
  /// `user_name` and `password` in the request body, so storing what we sent
  /// would put live vendor credentials in the database, in every backup, and in
  /// front of anyone with read access to this table. The canonical question is
  /// fully described by the columns above; the vendor-shaped payload adds
  /// nothing worth that.
  rawResponse Json?
  /// Set when rawResponse was cleared by the pruning pass. Successful calls
  /// keep their raw body for 30 days; failures keep theirs indefinitely,
  /// because a failure is the one you come back to months later.
  rawPrunedAt DateTime?

  capturedAt DateTime @default(now())

  snapshots VendorRateSnapshot[]

  /// The natural key of one question in one run. Makes every write an upsert,
  /// which matters because Inngest retries a step whose HTTP call landed but
  /// whose commit did not, and the alternative is silent duplicate rows that
  /// double-count in every aggregate afterwards.
  @@unique([runId, vendorId, destCountryCode, destPostcode, weightKg, boxProfile, shipmentPurpose], name: "sweep_call_identity")
  @@index([runId, status])
  @@index([runId, vendorId, status])
  @@index([vendorId, destCountryCode, capturedAt])
  /// Serves the pruning pass: successful calls, oldest first, that still hold a body.
  @@index([status, capturedAt])
}

model VendorRateSnapshot {
  id String @id @default(cuid())

  runId String
  run   RateSweepRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  callId String
  call   RateSweepCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  vendorId    String
  vendorName  String
  /// The vendor's own service label, e.g. "DHL Express". Stored RAW. Customer
  /// surfaces mask it through lib/branding, per carrierBranding.md; masking it
  /// here instead would make the data useless for working out which carrier is
  /// actually cheapest on a lane.
  productName String
  /// The vendor's id for the service, when it has one. Null for those that do not.
  courierId   String?

  // ── The service, normalised ──
  // Derived from productName at write time by lib/rateSweep/carrier.ts. Stored
  // rather than computed per query because the whole point of the sweep is that
  // "whose FedEx is cheapest to the US at 5kg" should be a GROUP BY, and three
  // vendors spell FedEx three different ways.
  //
  // Kept as a String rather than an enum deliberately. A new carrier appearing
  // in a vendor's catalogue is a rule change in code plus a backfill; making it
  // a schema change as well would mean the sweep has to file it under OTHER
  // until someone ships a migration.
  /// Normalised carrier code: FEDEX, DHL, UPS, ARAMEX, ... or OTHER when the
  /// label matched no rule. OTHER rows surface on the run screen's review list.
  carrier String @default("OTHER")

  /// Whether this price includes destination duties. See RateDutyMode.
  dutyMode        RateDutyMode    @default(UNKNOWN)
  contentType     RateContentType @default(UNKNOWN)
  /// Null when the label does not mention pickup, which is most of them.
  /// Recording those as false would invent a fact about what the price covers.
  pickupIncluded  Boolean?
  /// Caveats parsed from the label ("Gifts only", "B2B only"). A rate carrying
  /// one must not go into a general quotation unflagged.
  restrictionNote String?

  // ── The lane, denormalised ──
  // Repeated from RateSweepCall on purpose. This is the table every analytical
  // query reads, and making each of them join to filter by country or weight
  // would be a join per query for columns that are immutable once written.
  originPincode   String
  destCountryCode String  @db.Char(2)
  destPostcode    String
  weightKg        Decimal @db.Decimal(10, 3)
  boxProfile      String

  currency     String
  /// False when the vendor quoted in something other than INR. Aramex can, and
  /// a cheapest-of query that compared 400 USD against 4000 INR would return a
  /// confident wrong answer. Every comparison filters on this.
  isComparable Boolean @default(true)

  /// Raw vendor cost. Never marked up. See the note at the top of this section.
  totalWithTax    Decimal @db.Decimal(14, 2)
  totalWithoutTax Decimal @db.Decimal(14, 2)
  /// Derived at write time (withTax - withoutTax) so tax share is one column
  /// rather than an expression repeated in every query.
  taxAmount       Decimal @db.Decimal(14, 2)

  /// Transit days. 0 means the vendor did not say, which is common and is not
  /// the same as same-day.
  tatDays Int @default(0)

  charges VendorRateCharge[]

  /// The quoting read: everything for one lane at one weight, cheapest first.
  @@index([destCountryCode, weightKg, isComparable, totalWithTax])
  /// The carrier read: "whose FedEx is cheapest on this lane at this weight",
  /// which is the query the quotation sheet is built from.
  @@index([carrier, destCountryCode, weightKg, isComparable, totalWithTax])
  /// The trend read: one vendor's price for one lane over time.
  @@index([vendorId, destCountryCode, weightKg, capturedAt])
  @@index([runId])
  @@index([callId])
  @@index([capturedAt])
}

model VendorRateCharge {
  id String @id @default(cuid())

  snapshotId String
  snapshot   VendorRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// The vendor's own label, verbatim. Never shown to a customer.
  name          String
  /// The same charge under the wording customers see, via
  /// lib/invoices/tax/chargeNames.ts. Analysis groups on this, because
  /// "FREIGHT", "Freight charges" and "logistic fee" are the same line from
  /// three vendors and grouping on the raw name would make them three.
  canonicalName String

  amount   Decimal @db.Decimal(14, 2)
  currency String

  igst      Decimal? @db.Decimal(14, 2)
  cgst      Decimal? @db.Decimal(14, 2)
  sgst      Decimal? @db.Decimal(14, 2)
  taxAmount Decimal? @db.Decimal(14, 2)

  /// Preserves the vendor's own ordering, which usually runs freight first and
  /// tax last, so a stored breakdown reads like the quote it came from.
  sortOrder Int @default(0)

  @@index([snapshotId, sortOrder])
  /// The surcharge-trend read, which is most of why charges are rows.
  @@index([canonicalName])
}

// ─────────────────────────────────────────────
// RateQuotation — generated quotation workbooks
// ─────────────────────────────────────────────

/// Who a generated workbook was built for. Mirrors the zod enum in
/// lib/rateSweep/excel/spec.ts, and it is the field that decides whether the
/// file holds marked-up customer prices or Arena's raw buying cost.
enum RateQuotationAudience {
  CUSTOMER
  INTERNAL
}

/// Shape of the workbook: a sheet per carrier, or one best-price grid.
enum RateQuotationLayout {
  BY_SERVICE
  CHEAPEST
}

/// One generated Excel rate card, and the settings that produced it.
///
/// Named RateQuotation rather than RateCard because RateCard is already the
/// air-freight tariff table above. These are the quotation WORKBOOKS built off
/// the international rate sweep.
///
/// ── WHY THIS IS NOT A Quote ─────────────────────────────────────────────────
/// A Quote is one org's price for one shipment: one vendor, one lane, one
/// weight, one total, with a DRAFT/SENT workflow and an expiry the customer can
/// act on. A rate card is a grid — many countries by many weights by many
/// carriers — with no single price, often no client, and no workflow. Putting
/// the two in one table would mean making Quote.orgId nullable, and that column
/// is the org-scoping boundary every existing quotes query depends on.
///
/// ── THE FILE IS ONLY STORED FOR CUSTOMER CARDS ──────────────────────────────
/// UploadThing URLs are public and unguessable rather than access-controlled, so
/// a leaked link is permanent and unrevocable. A customer card holds prices the
/// customer is already allowed to see. An INTERNAL card is raw vendor cost with
/// every vendor named — Arena's buying price — so the row is written for the
/// audit trail but fileUrl stays null and the bytes only ever reach the browser
/// that asked for them.
///
/// ── EVERY GENERATION IS A NEW ROW ───────────────────────────────────────────
/// Never updated in place. "What did we actually send them in June" is the
/// question a rate dispute turns on, and regenerating over the top destroys it.
model RateQuotation {
  id String @id @default(cuid())

  /// Human-readable, sequential per year. What a person quotes back at us.
  cardNumber String @unique

  audience RateQuotationAudience
  layout   RateQuotationLayout

  /// The sweep this was priced from. Restricted rather than cascaded: deleting a
  /// run must not silently erase the record of what was sent to a customer.
  runId String
  run   RateSweepRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  /// The spec, spread into queryable columns rather than a JSON blob, because
  /// "which cards covered Germany" is a question the table needs to answer.
  countryCodes String[]
  weightsKg    Decimal[] @db.Decimal(8, 3)
  carriers     String[]

  markupPercent Decimal  @db.Decimal(6, 3)
  validityDays  Int
  validUntil    DateTime

  includeDutyUnpaid Boolean @default(false)
  includeRestricted Boolean @default(false)

  /// Printed on the cover. Free text so a prospect who is not yet a client can
  /// still be named.
  preparedFor String?

  /// Set when the card was built for somebody already on the books. SetNull, not
  /// Cascade: removing a client must not delete the record of what we sent them.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Clerk userId of the Arena staff member who generated it, and their name at
  /// the time. The name is denormalised on purpose — it has to still read
  /// correctly after somebody leaves and their Clerk record is gone.
  generatedByUserId String
  generatedByName   String?

  fileName String
  /// Null for INTERNAL cards, which are deliberately never persisted.
  fileUrl  String?
  fileKey  String?
  fileSize Int?

  /// What the file actually came out as, so the table can say "5 carriers, 12
  /// weights" without reopening the workbook.
  carrierCount Int
  sheetCount   Int

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([audience, createdAt])
  @@index([clientId])
  @@index([generatedByUserId])
}
