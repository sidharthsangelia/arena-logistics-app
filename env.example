# ─────────────────────────────────────────────────────────────────────────────
# Database (Neon)
# ─────────────────────────────────────────────────────────────────────────────
#
# Two connection strings pointing at the same database. Both are required in
# every environment, and the difference between them matters:
#
#   DATABASE_URL  the -pooler endpoint, through PgBouncer. Everything the app
#                 runs at request time uses this one.
#   DIRECT_URL    the same host WITHOUT "-pooler". Used only by the Prisma CLI
#                 for schema commands (`db push`, `db pull`), which take
#                 advisory locks and issue DDL that a pooled connection cannot
#                 reliably carry.
#
# Leaving DIRECT_URL unset does not fail the build any more — prisma.config.ts
# falls back to DATABASE_URL, because `prisma generate` never opens a connection
# — but it does mean `prisma db push` would run through PgBouncer, so set it.
DATABASE_URL = ""
DIRECT_URL = ""


SKART_USERNAME = ""
SKART_PASSWORD = ""


ARAMEX_USERNAME = ""
ARAMEX_PASSWORD = ""
ARAMEX_ACCOUNT_NUMBER = ""
ARAMEX_ACCOUNT_PIN = ""


# ─────────────────────────────────────────────────────────────────────────────
# Shipmozo — domestic + international rates, domestic booking, tracking
# ─────────────────────────────────────────────────────────────────────────────
#
# One key pair serves every Shipmozo integration: the rate adapters, the
# domestic booking adapter (push-order / assign-courier / label) and the
# tracking adapter behind /track. While these are blank, tracking a Shipmozo
# AWB returns one clean vendor error instead of a timeline, and no domestic
# courier order can be placed at all.
SHIPMOZO_PUBLIC_KEY = ""
SHIPMOZO_PRIVATE_KEY = ""

# Optional. Defaults to https://shipping-api.com/app/api/v1 (no trailing slash).
SHIPMOZO_API_URL = ""

# Our own token, embedded in the tracking webhook path we register in the
# Shipmozo panel:
#     https://<host>/api/webhooks/shipmozo/<SHIPMOZO_WEBHOOK_TOKEN>
# Shipmozo signs nothing, so this path segment is the only thing separating a
# real tracking post from stray traffic. Leave it blank and the route falls back
# to match-only: any payload is accepted, and acted on solely when its AWB or
# order id resolves to a real shipment. Set it in production.
SHIPMOZO_WEBHOOK_TOKEN = ""

# Optional. Declared value sent when a rate search carries no value of its own.
# Defaults to 50000.
SHIPMOZO_DEFAULT_DECLARED_VALUE = ""

# ─────────────────────────────────────────────────────────────────────────────
# SpeedoPost — domestic rates + booking + tracking
# ─────────────────────────────────────────────────────────────────────────────
#
# Same credentials as the SpeedoPost ERP login. One pair serves all three
# adapters: rates (EstimatedRate), booking (CreateWarehouse, CreateOrder,
# CreatePickupRequest, PrintLabel, CancelOrder) and the tracking behind /track.
# The client authenticates once and caches the JWT until shortly before its own
# expiry, so these are read on a cold process and rarely after.
#
# While these are blank every adapter fails fast with that reason rather than
# with the vendor's own words, so a missing credential never reads as an
# unserviceable route or an unknown waybill.
#
# BOOKING ALSO NEEDS SPEEDOPOST_CLIENT_CODE, below.
#
# ESCAPE ANY "$" IN THE PASSWORD AS "\$".
# Next.js runs dotenv-expand over this file, so a bare $ starts a variable
# reference and everything after it is substituted away. A password ending
# "@#$123" is loaded as "@#" and SpeedoPost answers "Invalid username or
# password", which reads exactly like wrong credentials. Quotes do not help;
# single quotes do not help either. Only the backslash does:
#     SPEEDOPOST_PASSWORD = "Secret@#\$123"
# This bites any secret containing $, for every vendor in this file. A trailing
# $ with nothing after it happens to be left alone, so SHIPGLOBAL_PASSWORD
# survived unescaped — but escape it anyway. "Safe" there depends on the $
# being LAST, so appending one character to that password would silently break
# it, and a silent break here costs a debugging session every time.
SPEEDOPOST_USER_ID = ""
SPEEDOPOST_PASSWORD = ""

# Optional. Defaults to https://admin.speedopost.com (live).
# UAT is https://uat.speedopost.com. Deliberately NOT defaulted to UAT: an
# unset variable in production would quote test prices as though they were real.
SPEEDOPOST_API_URL = ""

# REQUIRED TO BOOK, not to quote. SpeedoPost puts a "clientCode" on every
# CreateOrder call and has never explained where ours comes from; their own
# example sends "API". Ask them for the value on our account.
#
# Left blank, SpeedoPost quotes normally and the booking adapter reports itself
# unconfigured, which the booking job turns into a clean permanent failure with
# the money held. That is on purpose: guessing this either gets the order
# refused or files it under somebody else's client.
SPEEDOPOST_CLIENT_CODE = ""

# ─────────────────────────────────────────────────────────────────────────────
# ShipGlobal — international rate calculator
# ─────────────────────────────────────────────────────────────────────────────
#
# Basic-auth credentials for https://app.shipglobal.in. The adapter is always
# registered; while these are blank it returns one clean vendor error per rate
# search instead of a quote, and the other vendors are unaffected.
SHIPGLOBAL_USERNAME = ""
SHIPGLOBAL_PASSWORD = ""

# Optional overrides.
# SHIPGLOBAL_API_URL      — defaults to https://app.shipglobal.in/apiv1/rates/calculate
# SHIPGLOBAL_GST_PERCENT  — defaults to 18. ShipGlobal quotes `subtotal_fee`
#                           PRE-tax, so the adapter derives the GST line itself.
# SHIPGLOBAL_TIMEOUT_MS   — defaults to 20000. Bounds how long one slow vendor
#                           can hold the whole parallel rate search open.
SHIPGLOBAL_API_URL = ""
SHIPGLOBAL_GST_PERCENT = ""
SHIPGLOBAL_TIMEOUT_MS = ""

# White-label switch for ShipGlobal's OWN-BRAND services ("ShipGlobal Direct",
# "ShipGlobal First Class", "ShipGlobal Premium"). Leave unset until ShipGlobal
# grants written white-label permission. Set to "true" and customers see
# "Arena Direct" etc. on every surface at once; UPS / FedEx / DHL rows are never
# rebranded either way. Arena staff always see the raw name.
NEXT_PUBLIC_SHIPGLOBAL_WHITELABEL = ""

# Absolute base for links inside emails. No trailing slash.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL = ""

# Shared secret for the scheduled attention sweep at /api/cron/attention.
# Sent as `Authorization: Bearer <value>` by the cron scheduler.
CRON_SECRET = ""

# Alphabet used to obfuscate the shipment sequence value inside shipment
# numbers (ARN260130748291). Must be a permutation of the ten digits 0-9 —
# digits only, so the number stays easy to read out over a phone call.
# Leave blank to use the built-in default.
#
# WARNING: this is effectively permanent once shipments exist. Changing it
# re-maps every sequence value, so decodeShipmentNumber() will no longer
# reverse numbers issued under the previous alphabet.
SHIPMENT_ID_ALPHABET = ""


# ─────────────────────────────────────────────────────────────────────────────
# Inngest — background jobs (tax invoice generation, booking confirmation email)
# ─────────────────────────────────────────────────────────────────────────────
#
# Local development: set INNGEST_DEV=1 and run the dev server alongside `npm run dev`:
#   npx --ignore-scripts=false inngest-cli@latest dev -u http://localhost:3000/api/inngest
#
# Without INNGEST_DEV the SDK starts in cloud mode and /api/inngest returns 500
# with "in cloud mode but no signing key".
INNGEST_DEV = ""

# Production only. From the Inngest dashboard.
INNGEST_EVENT_KEY = ""
INNGEST_SIGNING_KEY = ""


# ─────────────────────────────────────────────────────────────────────────────
# Tax invoice issuer — who Arena's invoices are FROM
# ─────────────────────────────────────────────────────────────────────────────
#
# These print on every tax invoice raised to a customer. Defaults in
# lib/invoices/tax/config.ts are deliberately obvious placeholders, and the
# generation job REFUSES to issue an invoice while any of them is still in
# place: a gapless serial spent on a document with "REPLACE ME" where the GSTIN
# belongs leaves a hole no later fix can close.
#
# Fill these in before the first booking on a new environment.

# Which template EVERY invoice is drawn in, booking and manual alike: "grid"
# (the bordered, blue-banded format Arena issues, and the default) or "arena"
# (the quieter typographic one). Leave it unset for grid. Changing it does not
# restyle anything already issued: an invoice PDF is rendered once at issue and
# served back from storage thereafter.
INVOICE_TEMPLATE_VARIANT = "grid"

INVOICE_ISSUER_LEGAL_NAME = ""
INVOICE_ISSUER_TRADE_NAME = "Arena Cargo Logistics"

# Address lines separated by a pipe, e.g. "Unit 4, Some Tower|Sector 21".
INVOICE_ISSUER_ADDRESS = ""
INVOICE_ISSUER_CITY = ""
INVOICE_ISSUER_POSTAL_CODE = ""

# Must match the first two digits of the GSTIN below. This decides whether an
# invoice carries IGST or a CGST/SGST split, so a wrong value produces tax
# invoices under the wrong heads.
INVOICE_ISSUER_STATE_NAME = "Delhi"
INVOICE_ISSUER_STATE_CODE = "07"

INVOICE_ISSUER_GSTIN = ""
INVOICE_ISSUER_PAN = ""
# Corporate Identity Number. Optional: printed beside the GSTIN and PAN when set.
INVOICE_ISSUER_CIN = ""
# Udyam (MSME) registration number. Optional: printed beside the CIN when set.
INVOICE_ISSUER_MSME = ""
INVOICE_ISSUER_EMAIL = ""
INVOICE_ISSUER_PHONE = ""
INVOICE_ISSUER_WEBSITE = ""

# Printed at the foot of every invoice. The jurisdiction is read as
# "SUBJECT TO <value> JURISDICTION", so give it the places only.
INVOICE_ISSUER_JURISDICTION = "Delhi and Gurgaon"
# Several are allowed, comma separated. All of them are printed.
INVOICE_ISSUER_BILLING_EMAIL = "info@arenalogistics.co.in, adnan@arenalogistics.co.in"

# Optional. The bank block is printed only when an account number is set.
INVOICE_ISSUER_BANK_ACCOUNT = ""
INVOICE_ISSUER_BANK_ACCOUNT_NAME = ""
INVOICE_ISSUER_BANK_IFSC = ""
INVOICE_ISSUER_BANK_NAME = ""
INVOICE_ISSUER_BANK_BRANCH = ""

# Optional, and independent of the bank block: an issuer that publishes only a
# UPI handle still gets a payment block on the invoice. Printed as typed.
INVOICE_ISSUER_UPI_ID = ""


# ─────────────────────────────────────────────────────────────────────────────
# Public partner API  (/api/v1)
# ─────────────────────────────────────────────────────────────────────────────
#
# The rate and tracking endpoints another one of our websites calls. See
# publicApi.md for the full contract and an integration guide.
#
# These endpoints are NOT behind Clerk. They authenticate the key below and
# nothing else, so treat ARENA_API_KEYS with the same care as a vendor
# credential: anyone holding one can spend our paid vendor quota.

# Who may call, as a JSON array. Leave blank and every /api/v1 route answers
# 401 — which is the correct state until an integration exists.
#
#   name                   label for logs, Sentry and rate-limit keys. Not a
#                          secret and never sent to the caller except by
#                          /api/v1/health.
#   key                    the secret. 16 characters minimum; generate with
#                          `openssl rand -base64 32`. Rotate by editing this
#                          value and redeploying — it is re-read immediately.
#   orgId                  OPTIONAL Clerk org this key may resolve Arena
#                          shipment numbers (ARN…) for. Without it the key can
#                          still track a carrier waybill, but never an ARN.
#                          This is what stops a key holder walking our bookings.
#   markupIntlPercent      OPTIONAL per-consumer override of the two variables
#   markupDomesticPercent  below. Omit unless one consumer sells at a different
#                          margin from the others.
#   scopes                 OPTIONAL subset of ["rates:international",
#                          "rates:domestic","track"]. Omit to grant all three.
#
# A bare key (or several, comma-separated) is also accepted and means one
# all-scopes consumer with no org binding. Fine for a first integration.
#
# ARENA_API_KEYS = '[{"name":"arena-web","key":"REPLACE_ME","orgId":"org_xxx"}]'
ARENA_API_KEYS = ""

# ─── Markup on public API quotes ─────────────────────────────────────────────
#
# What margin these endpoints quote at. The tenant calculator reads
# Org.markupPercent from the database because every tenant differs; the public
# API has no tenant, so the number comes from here.
#
# Resolved first-hit-wins:
#   1. the consumer's own override in ARENA_API_KEYS
#   2. ARENA_API_MARKUP_PERCENT_INTL / ARENA_API_MARKUP_PERCENT_DOMESTIC
#   3. ARENA_API_MARKUP_PERCENT
#   4. 30, the same fallback the tenant calculator uses
#
# The maths is lib/pricing/markup.ts — the same module the calculator and the
# booking step use. A flat uplift on the grand total: 35 means every quote is
# vendor total x 1.35, with the breakdown scaled by the same factor.
#
# Editing any of these takes effect on the NEXT request. The rate cache stores
# pre-markup vendor cost precisely so a margin change is never held up behind
# a cache expiry.
ARENA_API_MARKUP_PERCENT = ""
ARENA_API_MARKUP_PERCENT_INTL = ""
ARENA_API_MARKUP_PERCENT_DOMESTIC = ""

# Set to "true" ONLY if you genuinely intend the API to quote at 0% markup.
#
# 0% is not "a free quote", it is our buying price published over HTTP to
# whoever holds a key. Without this switch a configured 0 is treated as a typo:
# the rate endpoints answer MISCONFIGURED, Sentry is notified, and no cost
# leaves the building. An UNSET markup variable is different and simply falls
# through to the next source.
ARENA_API_ALLOW_ZERO_MARKUP = ""

# How long an identical rate query is served from cache, in seconds.
# Default 900 (15 min). 0 disables caching; 3600 is the ceiling.
#
# A partner's pricing page asks the same lane on every visitor load, and each
# miss is a live billed call to four vendors. Cached rows hold vendor cost, not
# sell price, so this TTL never delays a markup change.
ARENA_API_RATE_CACHE_TTL_SECONDS = ""
