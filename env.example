SKART_USERNAME = ""
SKART_PASSWORD = ""


ARAMEX_USERNAME = ""
ARAMEX_PASSWORD = ""
ARAMEX_ACCOUNT_NUMBER = ""
ARAMEX_ACCOUNT_PIN = ""

# Absolute base for links inside emails. No trailing slash.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL = ""

# Shared secret for the scheduled attention sweep at /api/cron/attention.
# Sent as `Authorization: Bearer <value>` by the cron scheduler.
CRON_SECRET = ""

# Alphabet used to obfuscate the shipment sequence value inside shipment
# numbers (ARN260130748291). Must be a permutation of the ten digits 0-9 —
# digits only, so the number stays easy to read out over a phone call.
# Leave blank to use the built-in default.
#
# WARNING: this is effectively permanent once shipments exist. Changing it
# re-maps every sequence value, so decodeShipmentNumber() will no longer
# reverse numbers issued under the previous alphabet.
SHIPMENT_ID_ALPHABET = ""
