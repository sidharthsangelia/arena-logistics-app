SKART_USERNAME = ""
SKART_PASSWORD = ""


ARAMEX_USERNAME = ""
ARAMEX_PASSWORD = ""
ARAMEX_ACCOUNT_NUMBER = ""
ARAMEX_ACCOUNT_PIN = ""


# ─────────────────────────────────────────────────────────────────────────────
# Shipmozo — domestic + international rates, domestic booking, tracking
# ─────────────────────────────────────────────────────────────────────────────
#
# One key pair serves every Shipmozo integration: the rate adapters, the
# domestic booking adapter (push-order / assign-courier / label) and the
# tracking adapter behind /track. While these are blank, tracking a Shipmozo
# AWB returns one clean vendor error instead of a timeline, and no domestic
# courier order can be placed at all.
SHIPMOZO_PUBLIC_KEY = ""
SHIPMOZO_PRIVATE_KEY = ""

# Optional. Defaults to https://shipping-api.com/app/api/v1 (no trailing slash).
SHIPMOZO_API_URL = ""

# Our own token, embedded in the tracking webhook path we register in the
# Shipmozo panel:
#     https://<host>/api/webhooks/shipmozo/<SHIPMOZO_WEBHOOK_TOKEN>
# Shipmozo signs nothing, so this path segment is the only thing separating a
# real tracking post from stray traffic. Leave it blank and the route falls back
# to match-only: any payload is accepted, and acted on solely when its AWB or
# order id resolves to a real shipment. Set it in production.
SHIPMOZO_WEBHOOK_TOKEN = ""

# Optional. Declared value sent when a rate search carries no value of its own.
# Defaults to 50000.
SHIPMOZO_DEFAULT_DECLARED_VALUE = ""

# ─────────────────────────────────────────────────────────────────────────────
# ShipGlobal — international rate calculator
# ─────────────────────────────────────────────────────────────────────────────
#
# Basic-auth credentials for https://app.shipglobal.in. The adapter is always
# registered; while these are blank it returns one clean vendor error per rate
# search instead of a quote, and the other vendors are unaffected.
SHIPGLOBAL_USERNAME = ""
SHIPGLOBAL_PASSWORD = ""

# Optional overrides.
# SHIPGLOBAL_API_URL      — defaults to https://app.shipglobal.in/apiv1/rates/calculate
# SHIPGLOBAL_GST_PERCENT  — defaults to 18. ShipGlobal quotes `subtotal_fee`
#                           PRE-tax, so the adapter derives the GST line itself.
# SHIPGLOBAL_TIMEOUT_MS   — defaults to 20000. Bounds how long one slow vendor
#                           can hold the whole parallel rate search open.
SHIPGLOBAL_API_URL = ""
SHIPGLOBAL_GST_PERCENT = ""
SHIPGLOBAL_TIMEOUT_MS = ""

# White-label switch for ShipGlobal's OWN-BRAND services ("ShipGlobal Direct",
# "ShipGlobal First Class", "ShipGlobal Premium"). Leave unset until ShipGlobal
# grants written white-label permission. Set to "true" and customers see
# "Arena Direct" etc. on every surface at once; UPS / FedEx / DHL rows are never
# rebranded either way. Arena staff always see the raw name.
NEXT_PUBLIC_SHIPGLOBAL_WHITELABEL = ""

# Absolute base for links inside emails. No trailing slash.
# e.g. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL = ""

# Shared secret for the scheduled attention sweep at /api/cron/attention.
# Sent as `Authorization: Bearer <value>` by the cron scheduler.
CRON_SECRET = ""

# Alphabet used to obfuscate the shipment sequence value inside shipment
# numbers (ARN260130748291). Must be a permutation of the ten digits 0-9 —
# digits only, so the number stays easy to read out over a phone call.
# Leave blank to use the built-in default.
#
# WARNING: this is effectively permanent once shipments exist. Changing it
# re-maps every sequence value, so decodeShipmentNumber() will no longer
# reverse numbers issued under the previous alphabet.
SHIPMENT_ID_ALPHABET = ""


# ─────────────────────────────────────────────────────────────────────────────
# Inngest — background jobs (tax invoice generation, booking confirmation email)
# ─────────────────────────────────────────────────────────────────────────────
#
# Local development: set INNGEST_DEV=1 and run the dev server alongside `npm run dev`:
#   npx --ignore-scripts=false inngest-cli@latest dev -u http://localhost:3000/api/inngest
#
# Without INNGEST_DEV the SDK starts in cloud mode and /api/inngest returns 500
# with "in cloud mode but no signing key".
INNGEST_DEV = ""

# Production only. From the Inngest dashboard.
INNGEST_EVENT_KEY = ""
INNGEST_SIGNING_KEY = ""


# ─────────────────────────────────────────────────────────────────────────────
# Tax invoice issuer — who Arena's invoices are FROM
# ─────────────────────────────────────────────────────────────────────────────
#
# These print on every tax invoice raised to a customer. Defaults in
# lib/invoices/tax/config.ts are deliberately obvious placeholders, and the
# generation job REFUSES to issue an invoice while any of them is still in
# place: a gapless serial spent on a document with "REPLACE ME" where the GSTIN
# belongs leaves a hole no later fix can close.
#
# Fill these in before the first booking on a new environment.

INVOICE_ISSUER_LEGAL_NAME = ""
INVOICE_ISSUER_TRADE_NAME = "Arena Cargo Logistics"

# Address lines separated by a pipe, e.g. "Unit 4, Some Tower|Sector 21".
INVOICE_ISSUER_ADDRESS = ""
INVOICE_ISSUER_CITY = ""
INVOICE_ISSUER_POSTAL_CODE = ""

# Must match the first two digits of the GSTIN below. This decides whether an
# invoice carries IGST or a CGST/SGST split, so a wrong value produces tax
# invoices under the wrong heads.
INVOICE_ISSUER_STATE_NAME = "Delhi"
INVOICE_ISSUER_STATE_CODE = "07"

INVOICE_ISSUER_GSTIN = ""
INVOICE_ISSUER_PAN = ""
INVOICE_ISSUER_EMAIL = ""
INVOICE_ISSUER_PHONE = ""
INVOICE_ISSUER_WEBSITE = ""

# Printed at the foot of every invoice. The jurisdiction is read as
# "SUBJECT TO <value> JURISDICTION", so give it the places only.
INVOICE_ISSUER_JURISDICTION = "Delhi and Gurgaon"
INVOICE_ISSUER_BILLING_EMAIL = "info@arenalogistics.co.in"

# Optional. The bank block is printed only when an account number is set.
INVOICE_ISSUER_BANK_ACCOUNT = ""
INVOICE_ISSUER_BANK_ACCOUNT_NAME = ""
INVOICE_ISSUER_BANK_IFSC = ""
INVOICE_ISSUER_BANK_NAME = ""
INVOICE_ISSUER_BANK_BRANCH = ""
